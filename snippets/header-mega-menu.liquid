{% doc %}
  Renders one compact, vertical and accessible FourPattes desktop submenu.

  The selected Shopify Navigation menu supplies up to seven top-level links.
  When the dedicated picker is empty, the snippet resolves the conventional
  universe menu handle, then an exact matching parent in main-menu. It never
  exposes unrelated main-menu links as submenu categories.

  @param {linklist} menu - Dedicated Shopify Navigation menu.
  @param {string} menu_id - Unique panel DOM id.
  @param {string} trigger_id - Id of the controlling button.
  @param {string} label - Visible universe label.
  @param {string} alignment - start, center or end.
  @param {image} image - Optional compact editorial image.
  @param {string} image_alt - Optional merchant-defined image alternative.
  @param {boolean} card_enabled - Whether the compact card is enabled.
  @param {string} card_title - Compact card title.
  @param {string} card_text - Compact card text.
  @param {string} cta_label - Card or footer CTA label.
  @param {string} cta_link - Card and universe destination.
  @param {color} card_background - Card background colour.
  @param {array} badge_blocks - Section badge blocks.
  @param {string} badge_universe - dog, cat or discover.
  @param {boolean} show_badges - Global badge visibility.
  @param {string} editor_message - Theme Editor empty-state guidance.
{% enddoc %}

{%- if badge_universe == 'dog' -%}
  {{ 'pet-header-compact-fix.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign resolved_menu = menu
  assign conventional_menu_handle = blank
  assign card_has_content = false
  assign has_menu_links = false
  assign rendered_badges = 0
  assign panel_alignment = alignment | default: 'center'
  assign image_alt_value = image_alt | default: image.alt | default: card_title
  assign patous_alt = 'Patous, the FourPattes mascot'

  case badge_universe
    when 'dog'
      assign conventional_menu_handle = 'univers-chien'
    when 'cat'
      assign conventional_menu_handle = 'univers-chat'
    when 'discover'
      assign conventional_menu_handle = 'decouvrir'
  endcase

  if request.locale.iso_code contains 'fr'
    assign patous_alt = 'Patous, la mascotte FourPattes'
  endif

  if resolved_menu == blank or resolved_menu.links == blank
    if conventional_menu_handle != blank
      assign conventional_menu = linklists[conventional_menu_handle]
      if conventional_menu != blank and conventional_menu.links != blank
        assign resolved_menu = conventional_menu
      endif
    endif
  endif

  if resolved_menu == blank or resolved_menu.links == blank
    assign primary_menu = linklists['main-menu']
    assign expected_parent_handle = label | handleize

    if primary_menu != blank and primary_menu.links != blank
      for primary_link in primary_menu.links
        assign primary_link_handle = primary_link.title | handleize
        if primary_link_handle == expected_parent_handle and primary_link.links != blank
          assign resolved_menu = primary_link
          break
        endif
      endfor
    endif
  endif

  if resolved_menu != blank and resolved_menu.links != blank
    assign has_menu_links = true
  endif

  if card_enabled
    if image != blank or card_title != blank or card_text != blank or cta_label != blank
      assign card_has_content = true
    endif
  endif
-%}

<div
  class="pet-header__mega pet-header__mega--compact pet-header__mega--align-{{ panel_alignment }}"
  id="{{ menu_id }}"
  role="region"
  aria-labelledby="{{ trigger_id }}"
  hidden
  data-pet-mega-panel
>
  <div
    class="pet-header__mega-inner"
    style="--pet-submenu-card-bg: {{ card_background | default: '#E7F8F7' }};"
  >
    <div class="pet-header__mega-titlebar">
      <strong>{{ label }}</strong>
    </div>

    <div class="pet-header__submenu-body">
      {%- if has_menu_links -%}
        <ul class="pet-header__submenu-list" role="list">
          {%- for link in resolved_menu.links limit: 7 -%}
            {%- liquid
              assign matched_badge = blank

              if show_badges and rendered_badges < 2
                for block in badge_blocks
                  if block.type == 'submenu_badge' and block.settings.universe == badge_universe and block.settings.link_label == link.title and block.settings.badge_text != blank
                    assign matched_badge = block
                    assign rendered_badges = rendered_badges | plus: 1
                    break
                  endif
                endfor
              endif
            -%}
            <li>
              <a
                class="pet-header__submenu-link{% if forloop.first %} is-featured{% endif %}"
                href="{{ link.url }}"
                {% if link.current %}aria-current="page"{% endif %}
              >
                <span class="pet-header__submenu-link-label">{{ link.title }}</span>
                <span class="pet-header__submenu-link-meta">
                  {%- if matched_badge != blank -%}
                    <span
                      class="pet-header__submenu-badge pet-header__submenu-badge--{{ matched_badge.settings.style }}"
                      {{ matched_badge.shopify_attributes }}
                    >
                      {{ matched_badge.settings.badge_text }}
                    </span>
                  {%- endif -%}
                  <span class="pet-header__submenu-arrow" aria-hidden="true">
                    {% render 'fourpattes-header-icon', name: 'arrow' %}
                  </span>
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- elsif request.design_mode -%}
        <div class="pet-header__submenu-editor-help" role="status">
          <strong>{{ label }}</strong>
          <span>{{ editor_message }}</span>
        </div>
      {%- endif -%}

      {%- if card_has_content -%}
        {%- if has_menu_links or request.design_mode -%}<div class="pet-header__submenu-separator" aria-hidden="true"></div>{%- endif -%}
        <a class="pet-header__submenu-card" href="{{ cta_link }}">
          {%- if image != blank -%}
            <span class="pet-header__submenu-card-media">
              {{ image
                | image_url: width: 360
                | image_tag:
                  widths: '120, 180, 240, 360',
                  sizes: '(min-width: 1120px) 108px, 1px',
                  loading: 'eager',
                  alt: image_alt_value
              }}
            </span>
          {%- else -%}
            <span class="pet-header__submenu-card-media pet-header__submenu-card-media--patous">
              <img
                src="{{ 'mascotte-fourpattes-bandana.webp' | asset_url }}"
                width="863"
                height="1027"
                loading="eager"
                decoding="async"
                alt="{{ patous_alt | escape }}"
              >
            </span>
          {%- endif -%}
          <span class="pet-header__submenu-card-copy">
            {%- if card_title != blank -%}<strong>{{ card_title }}</strong>{%- endif -%}
            {%- if card_text != blank -%}<span>{{ card_text }}</span>{%- endif -%}
            {%- if cta_label != blank -%}
              <b>
                <span>{{ cta_label }}</span>
                <span aria-hidden="true">{% render 'fourpattes-header-icon', name: 'arrow' %}</span>
              </b>
            {%- endif -%}
          </span>
        </a>
      {%- elsif cta_link != blank -%}
        {%- if has_menu_links or request.design_mode -%}<div class="pet-header__submenu-separator" aria-hidden="true"></div>{%- endif -%}
        <a class="pet-header__submenu-footer-link" href="{{ cta_link }}">
          <span>{{ cta_label | default: label }}</span>
          <span aria-hidden="true">{% render 'fourpattes-header-icon', name: 'arrow' %}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
