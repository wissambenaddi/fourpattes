{% doc %}
Loads the Fourpattes font files and exposes the responsive typography tokens used by the theme.
{% enddoc %}

{%- liquid
  assign body_font_500 = settings.type_body_font | font_modify: 'weight', '500'
  assign body_font_600 = settings.type_body_font | font_modify: 'weight', '600'
  assign body_font_700 = settings.type_body_font | font_modify: 'weight', '700'
-%}

{% style %}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {%- if body_font_500 != blank -%}{{ body_font_500 | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if body_font_600 != blank -%}{{ body_font_600 | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if body_font_700 != blank -%}{{ body_font_700 | font_face: font_display: 'swap' }}{%- endif -%}

  @font-face {
    font-family: "Fredoka";
    src: url("{{ 'fredoka-latin-500.woff2' | asset_url }}") format("woff2");
    font-style: normal;
    font-weight: 500;
    font-display: swap;
  }
  @font-face {
    font-family: "Fredoka";
    src: url("{{ 'fredoka-latin-600.woff2' | asset_url }}") format("woff2");
    font-style: normal;
    font-weight: 600;
    font-display: swap;
  }
  @font-face {
    font-family: "Fredoka";
    src: url("{{ 'fredoka-latin-700.woff2' | asset_url }}") format("woff2");
    font-style: normal;
    font-weight: 700;
    font-display: swap;
  }
  @font-face {
    font-family: "Caveat";
    src: url("{{ 'caveat-latin-600.woff2' | asset_url }}") format("woff2");
    font-style: normal;
    font-weight: 600;
    font-display: swap;
  }
  @font-face {
    font-family: "Caveat";
    src: url("{{ 'caveat-latin-700.woff2' | asset_url }}") format("woff2");
    font-style: normal;
    font-weight: 700;
    font-display: swap;
  }

  :root {
    --font-heading-family: "Fredoka", {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-handwritten-family: "Caveat", "Segoe Print", cursive;
    --font-heading-weight: 700;
    --font-body-weight: 400;
    --font-weight-regular: 400;
    --font-weight-medium: 500;
    --font-weight-semibold: 600;
    --font-weight-bold: 700;
    --pet-font-heading: var(--font-heading-family);
    --pet-font-body: var(--font-body-family);
    --pet-font-handwritten: var(--font-handwritten-family);
    --pet-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --pet-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
    --text-xs: clamp(.75rem, .72rem + .1vw, .8125rem);
    --text-sm: clamp(.875rem, .84rem + .15vw, .96875rem);
    --text-base: clamp(.9375rem, .9rem + .18vw, 1.0625rem);
    --text-lg: clamp(1.0625rem, 1rem + .28vw, 1.25rem);
    --text-xl: clamp(1.25rem, 1.1rem + .6vw, 1.625rem);
    --text-2xl: clamp(1.55rem, 1.32rem + .95vw, 2.15rem);
    --text-h1: clamp(2rem, 1.55rem + 2.05vw, 3.75rem);
    --text-h2: clamp(1.625rem, 1.35rem + 1.25vw, 3rem);
    --text-h3: clamp(1.25rem, 1.12rem + .55vw, 1.75rem);
    --text-h4: clamp(1.125rem, 1.05rem + .35vw, 1.375rem);
    --text-h5: clamp(1rem, .96rem + .2vw, 1.1875rem);
    --text-h6: clamp(.875rem, .84rem + .18vw, 1.0625rem);
    --text-hero: clamp(2.125rem, 1.6rem + 2.6vw, 4.75rem);
    --text-button: clamp(.875rem, .84rem + .12vw, 1rem);
  }
{% endstyle %}
