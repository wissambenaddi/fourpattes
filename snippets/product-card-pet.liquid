{% doc %}
  Renders a responsive Shopify product card.
  @param {product} product - Shopify product object.
  @param {number} [index] - Card index used for loading priority and legacy palettes.
  @param {boolean} [show_quick_add] - Shows native quick-add form.
  @param {string} [image_ratio] - square, portrait or adapt.
  @param {boolean} [collection_context] - Enables collection-only media and availability enhancements.
{% enddoc %}

{%- liquid
  assign card_index = index | default: 1
  assign palette_index = card_index | modulo: 5 | plus: 1
  assign selected_variant = product.selected_or_first_available_variant
  assign minimum_price = product.price_min | money
  assign rating_value = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign is_collection_card = collection_context | default: false
  assign secondary_image = blank
  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'
  assign ratio_value = '1 / 1'
  assign primary_image_class = 'pet-product-card__image pet-product-card__image--primary'

  if request.page_type == 'collection'
    assign is_collection_card = true
  endif

  if is_collection_card
    assign secondary_image = product.images[1]
    if card_index <= 4
      assign image_loading = 'eager'
    endif
    if card_index == 1
      assign image_fetchpriority = 'high'
    endif
  endif

  if secondary_image != blank
    assign primary_image_class = primary_image_class | append: ' has-secondary'
  endif

  case image_ratio
    when 'portrait'
      assign ratio_value = '4 / 5'
    when 'adapt'
      if product.featured_image.aspect_ratio != blank
        assign ratio_value = product.featured_image.aspect_ratio
      endif
  endcase

  assign available_label = 'Available'
  assign unavailable_label = 'Unavailable'
  if request.locale.iso_code contains 'fr'
    assign available_label = 'Disponible'
    assign unavailable_label = 'Indisponible'
  endif
-%}

<article
  class="pet-product-card pet-product-card--{{ palette_index }} pet-product-card--tilt-{{ card_index | modulo: 3 }}{% if is_collection_card %} pet-product-card--collection{% endif %}"
  style="--fp-product-image-ratio: {{ ratio_value }};"
>
  <a class="pet-product-card__link" href="{{ product.url }}">
    <div class="pet-product-card__media">
      {%- if product.compare_at_price > product.price -%}
        <span class="pet-badge pet-badge--sale">Promo</span>
      {%- elsif product.tags contains 'Bestseller' or product.tags contains 'Best-seller' -%}
        <span class="pet-badge pet-badge--bestseller">Bestseller</span>
      {%- elsif product.tags contains 'Nouveau' or product.tags contains 'new' -%}
        <span class="pet-badge pet-badge--new">Nouveau</span>
      {%- endif -%}

      {%- if product.featured_image != blank -%}
        {{ product.featured_image
          | image_url: width: 800
          | image_tag:
            widths: '220, 320, 480, 640, 800',
            sizes: '(min-width: 1200px) 22vw, (min-width: 750px) 30vw, 46vw',
            loading: image_loading,
            fetchpriority: image_fetchpriority,
            class: primary_image_class,
            alt: product.featured_image.alt | default: product.title
        }}
        {%- if secondary_image != blank -%}
          {{ secondary_image
            | image_url: width: 800
            | image_tag:
              widths: '220, 320, 480, 640, 800',
              sizes: '(min-width: 1200px) 22vw, (min-width: 750px) 30vw, 46vw',
              loading: 'lazy',
              class: 'pet-product-card__image pet-product-card__image--secondary',
              alt: secondary_image.alt | default: product.title
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'pet-product-card__placeholder' }}
      {%- endif -%}
    </div>

    <div class="pet-product-card__content">
      <h3 class="pet-product-card__title">{{ product.title }}</h3>

      {%- if rating_value != blank -%}
        <div class="pet-product-card__rating" aria-label="{{ rating_value.rating }} sur {{ rating_value.scale_max }}">
          <span aria-hidden="true">★</span>
          <strong>{{ rating_value.rating | round: 1 }}</strong>
          {%- if rating_count != blank -%}<small>({{ rating_count }})</small>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="pet-product-card__price">
        {%- if product.price_varies -%}
          {{ 'products.price_from' | t: price: minimum_price }}
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
        {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
      </div>

      {%- if is_collection_card -%}
        <span class="pet-product-card__availability">
          {%- if product.available -%}{{ available_label }}{%- else -%}{{ unavailable_label }}{%- endif -%}
        </span>
      {%- endif -%}
    </div>
  </a>

  {%- if show_quick_add -%}
    {%- if product.available and product.has_only_default_variant -%}
      {%- form 'product', product, class: 'pet-quick-add', data-pet-quick-add: '' -%}
        <input type="hidden" name="id" value="{{ selected_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button class="pet-quick-add__button" type="submit" aria-label="{{ 'general.add_to_cart' | t }} – {{ product.title | escape }}">
          <span>{{ 'general.add_to_cart' | t }}</span><b aria-hidden="true">+</b>
        </button>
      {%- endform -%}
    {%- elsif product.available -%}
      <a class="pet-product-card__options" href="{{ product.url }}">{{ 'general.choose_options' | t }}</a>
    {%- else -%}
      <span class="pet-product-card__soldout">{{ 'general.sold_out' | t }}</span>
    {%- endif -%}
  {%- endif -%}
</article>
