{% doc %}
  Renders an organic full-width divider.
  @param {string} color - CSS color value.
  @param {string} [position] - top or bottom.
  @param {boolean} [flip] - Mirror the wave horizontally.
{% enddoc %}
<svg
  class="pet-wave pet-wave--{{ position | default: 'top' }}{% if flip %} pet-wave--flip{% endif %}"
  style="color: {{ color }}"
  viewBox="0 0 1440 120"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path fill="currentColor" d="M0 54c79-6 91 41 167 38 93-4 101-67 205-57 78 8 99 53 184 42 79-10 104-73 202-54 72 14 95 65 187 55 92-10 105-57 194-46 91 11 117 70 201 54 41-8 68-27 100-34v68H0V54Z"/>
</svg>
