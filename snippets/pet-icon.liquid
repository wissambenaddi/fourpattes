  {%- when 'support' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h16v11H9l-5 4v-15Z"/><path d="M8.5 10.5c.8-1.2 2.2-.9 2.6.2.4-1.1 1.8-1.4 2.6-.2.9 1.4-.6 2.8-2.6 4-2-1.2-3.5-2.6-2.6-4Z"/></svg>
