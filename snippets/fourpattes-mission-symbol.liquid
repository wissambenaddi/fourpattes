{% doc %}
  Renders a compact FourPattes mission symbol.
  @param {string} symbol - Symbol name: paw, dog, cat, heart, gift, sparkle, globe.
  @param {string} [class] - Optional CSS class.
{% enddoc %}

{%- case symbol -%}
  {%- when 'dog' -%}
    <span class="{{ class }}" aria-hidden="true">{% render 'icon-dog' %}</span>
  {%- when 'cat' -%}
    <span class="{{ class }}" aria-hidden="true">{% render 'icon-cat' %}</span>
  {%- when 'heart' -%}
    <svg class="{{ class }}" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <path d="M16 27.2 5.3 17.1C-.4 11.7 3.3 3 10.4 3c2.4 0 4.5 1.2 5.6 3.1A6.4 6.4 0 0 1 21.6 3c7.1 0 10.8 8.7 5.1 14.1L16 27.2Z" fill="currentColor"/>
    </svg>
  {%- when 'gift' -%}
    <svg class="{{ class }}" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <path d="M4 13h24v15H4V13Zm-1-6h26v7H3V7Zm13 0v21M16 7c-1.2-4.7-8.8-5-8.8-.7C7.2 9.4 12 9 16 7Zm0 0c1.2-4.7 8.8-5 8.8-.7 0 3.1-4.8 2.7-8.8.7Z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
    </svg>
  {%- when 'sparkle' -%}
    <svg class="{{ class }}" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <path d="M16 2c1.2 8.4 5.6 12.8 14 14-8.4 1.2-12.8 5.6-14 14-1.2-8.4-5.6-12.8-14-14C10.4 14.8 14.8 10.4 16 2Z" fill="currentColor"/>
    </svg>
  {%- when 'globe' -%}
    <svg class="{{ class }}" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="2.2"/>
      <path d="M4.8 12h22.4M4.8 20h22.4M16 4c4 4.1 5.6 8.1 5.6 12S20 23.9 16 28c-4-4.1-5.6-8.1-5.6-12S12 8.1 16 4Z" fill="none" stroke="currentColor" stroke-width="2"/>
    </svg>
  {%- else -%}
    <span class="{{ class }}" aria-hidden="true">{% render 'icon-paw' %}</span>
{%- endcase -%}
