{% doc %}
  Renders one lightweight outline icon for the FourPattes premium header.

  @param {string} name - menu, close, search, account, chevron, arrow, dog, cat, discover or story.
{% enddoc %}
{%- case name -%}
  {%- when 'menu' -%}
    <svg class="pet-header-icon pet-header-icon--menu" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  {%- when 'close' -%}
    <svg class="pet-header-icon pet-header-icon--close" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18"/></svg>
  {%- when 'search' -%}
    <svg class="pet-header-icon pet-header-icon--search" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.7" cy="10.7" r="6.2"/><path d="m15.4 15.4 4.1 4.1"/></svg>
  {%- when 'account' -%}
    <svg class="pet-header-icon pet-header-icon--account" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 19.2c.8-3.3 3-5 6.5-5s5.7 1.7 6.5 5"/></svg>
  {%- when 'chevron' -%}
    <svg class="pet-header-icon pet-header-icon--chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m7.5 9.5 4.5 4.5 4.5-4.5"/></svg>
  {%- when 'arrow' -%}
    <svg class="pet-header-icon pet-header-icon--arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h13M14 7l5 5-5 5"/></svg>
  {%- when 'dog' -%}
    <svg class="pet-header-icon pet-header-icon--dog" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7.1 8.2 4.4 6.5l-.6 4.1 2.1 1.5v2.3c0 3.2 2.5 5.1 6.1 5.1s6.1-1.9 6.1-5.1v-2.3l2.1-1.5-.6-4.1-2.7 1.7A7.6 7.6 0 0 0 12 6.5a7.6 7.6 0 0 0-4.9 1.7Z"/><path d="M9.2 12.2h.1m5.4 0h.1M10 15.2c1.2.9 2.8.9 4 0"/></svg>
  {%- when 'cat' -%}
    <svg class="pet-header-icon pet-header-icon--cat" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6.5 8.6-.3-4 4 2.2c.6-.2 1.2-.3 1.8-.3s1.2.1 1.8.3l4-2.2-.3 4c1.1 1.2 1.7 2.8 1.7 4.6 0 3.8-2.8 6.3-7.2 6.3s-7.2-2.5-7.2-6.3c0-1.8.6-3.4 1.7-4.6Z"/><path d="M8.8 12.3h.1m6.2 0h.1M10.1 15.2c1.1.7 2.7.7 3.8 0M4.4 14.1l3 .4m12.2-.4-3 .4"/></svg>
  {%- when 'discover' -%}
    <svg class="pet-header-icon pet-header-icon--discover" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 3 1.2 4.3L17.5 9l-4.3 1.5L12 15l-1.2-4.5L6.5 9l4.3-1.7L12 3Z"/><path d="m18.5 14 .7 2.3 2.3.7-2.3.8-.7 2.2-.8-2.2-2.2-.8 2.2-.7.8-2.3ZM5.5 14.5l.5 1.6 1.6.5-1.6.5-.5 1.6-.5-1.6-1.6-.5 1.6-.5.5-1.6Z"/></svg>
  {%- when 'story' -%}
    <svg class="pet-header-icon pet-header-icon--story" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.2 4.7 13A4.7 4.7 0 0 1 11.3 6l.7.8.7-.8a4.7 4.7 0 0 1 6.6 7L12 20.2Z"/></svg>
{%- endcase -%}
