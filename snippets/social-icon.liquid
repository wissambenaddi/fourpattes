{% doc %}
  Renders a compact social network icon.
  @param {string} name - instagram, tiktok, facebook or pinterest.
{% enddoc %}
{%- case name -%}
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle class="pet-social-icon__dot" cx="17.5" cy="6.5" r="1"/></svg>
  {%- when 'tiktok' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4v10.3a4.3 4.3 0 1 1-3.3-4.2M14 4c.8 3.2 2.7 4.8 5.4 4.9"/></svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 21v-8h2.8l.5-3h-3.3V8.1c0-.9.3-1.6 1.7-1.6H18V3.8c-.5-.1-1.4-.2-2.5-.2-2.5 0-4.2 1.5-4.2 4.3V10H8.5v3h2.8v8"/></svg>
  {%- when 'pinterest' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.2 20.5c.8-2.2 1-3.3 1.5-5.8-.8-1.5.1-5.1 2.4-5.1 1.6 0 1.7 1.5 1.3 2.8-.4 1.6-1.2 3.2.4 4 1.5.8 4-1 4-4.8 0-3.6-2.9-5.8-6.5-5.8-4.5 0-7.1 3.3-7.1 6.7 0 1.3.5 2.7 1.5 3.5"/></svg>
{%- endcase -%}
