{% doc %}
  Renders one FourPattes mobile universe as a single-level accessible accordion.

  The dedicated Shopify Navigation menu supplies up to six top-level links.
  When no menu is selected, the storefront keeps the compact accordion with its
  direct universe link while the Theme Editor can show configuration guidance.

  @param {linklist} menu - Dedicated Shopify Navigation menu.
  @param {string} label - Visible universe label.
  @param {string} icon - FourPattes icon name.
  @param {string} fallback_link - Direct universe destination.
  @param {boolean} force_accordion - Keeps the accordion markup when submenus are enabled.
  @param {boolean} card_enabled - Whether the editorial card is enabled.
  @param {boolean} card_mobile - Whether the reduced card appears in the drawer.
  @param {image} image - Optional card image.
  @param {string} image_alt - Optional merchant-defined image alternative.
  @param {string} card_title - Compact card title.
  @param {string} card_text - Compact card text.
  @param {string} cta_label - Card CTA label.
  @param {color} card_background - Card background colour.
  @param {array} badge_blocks - Section badge blocks.
  @param {string} badge_universe - dog, cat or discover.
  @param {boolean} show_badges - Global badge visibility.
  @param {string} editor_message - Theme Editor empty-state guidance.
{% enddoc %}

{%- liquid
  assign has_menu_links = false
  assign card_has_content = false
  assign rendered_badges = 0
  assign view_all_text = 'View all'
  assign image_alt_value = image_alt | default: image.alt | default: card_title

  if request.locale.iso_code contains 'fr'
    assign view_all_text = 'Voir tout'
  endif

  if menu != blank and menu.links != blank
    assign has_menu_links = true
  endif

  if card_enabled and card_mobile
    if image != blank or card_title != blank or card_text != blank or cta_label != blank
      assign card_has_content = true
    endif
  endif
-%}

<li class="pet-menu-drawer__item">
  {%- if has_menu_links or force_accordion or request.design_mode -%}
    <details class="pet-menu-drawer__details">
      <summary>
        <span class="pet-menu-drawer__summary-label">
          <span class="pet-menu-drawer__universe-icon" aria-hidden="true">
            {% render 'fourpattes-header-icon', name: icon %}
          </span>
          <span>{{ label }}</span>
        </span>
        <span class="pet-menu-drawer__chevron" aria-hidden="true">
          {% render 'fourpattes-header-icon', name: 'chevron' %}
        </span>
      </summary>

      <div class="pet-menu-drawer__submenu-content">
        {%- if has_menu_links -%}
          <ul class="pet-menu-drawer__sublist" role="list">
            {%- for link in menu.links limit: 6 -%}
              {%- liquid
                assign matched_badge = blank

                if show_badges and rendered_badges < 2
                  for block in badge_blocks
                    if block.type == 'submenu_badge' and block.settings.universe == badge_universe and block.settings.link_label == link.title and block.settings.badge_text != blank
                      assign matched_badge = block
                      assign rendered_badges = rendered_badges | plus: 1
                      break
                    endif
                  endfor
                endif
              -%}
              <li>
                <a
                  class="pet-menu-drawer__submenu-link{% if forloop.first %} is-featured{% endif %}"
                  href="{{ link.url }}"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  <span>{{ link.title }}</span>
                  <span class="pet-menu-drawer__submenu-meta">
                    {%- if matched_badge != blank -%}
                      <span class="pet-header__submenu-badge pet-header__submenu-badge--{{ matched_badge.settings.style }}" {{ matched_badge.shopify_attributes }}>
                        {{ matched_badge.settings.badge_text }}
                      </span>
                    {%- endif -%}
                    <span aria-hidden="true">{% render 'fourpattes-header-icon', name: 'arrow' %}</span>
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- elsif request.design_mode -%}
          <div class="pet-header__submenu-editor-help" role="status">
            <strong>{{ label }}</strong>
            <span>{{ editor_message }}</span>
          </div>
        {%- endif -%}

        {%- if card_has_content -%}
          <a
            class="pet-menu-drawer__submenu-card"
            href="{{ fallback_link }}"
            style="--pet-submenu-card-bg: {{ card_background | default: '#E7F8F7' }};"
          >
            {%- if image != blank -%}
              <span class="pet-menu-drawer__submenu-card-media">
                {{ image
                  | image_url: width: 240
                  | image_tag:
                    widths: '96, 144, 192, 240',
                    sizes: '72px',
                    loading: 'lazy',
                    alt: image_alt_value
                }}
              </span>
            {%- else -%}
              <span class="pet-menu-drawer__submenu-card-illustration" aria-hidden="true">
                {% render 'fourpattes-header-icon', name: icon %}
              </span>
            {%- endif -%}
            <span class="pet-menu-drawer__submenu-card-copy">
              {%- if card_title != blank -%}<strong>{{ card_title }}</strong>{%- endif -%}
              {%- if card_text != blank -%}<span>{{ card_text }}</span>{%- endif -%}
              {%- if cta_label != blank -%}<b>{{ cta_label }}</b>{%- endif -%}
            </span>
          </a>
        {%- endif -%}

        {%- if fallback_link != blank -%}
          <a class="pet-menu-drawer__view-all" href="{{ fallback_link }}">
            <span>{{ view_all_text }} — {{ label }}</span>
            <span aria-hidden="true">{% render 'fourpattes-header-icon', name: 'arrow' %}</span>
          </a>
        {%- endif -%}
      </div>
    </details>
  {%- else -%}
    <a class="pet-menu-drawer__direct-link" href="{{ fallback_link }}">
      <span class="pet-menu-drawer__summary-label">
        <span class="pet-menu-drawer__universe-icon" aria-hidden="true">
          {% render 'fourpattes-header-icon', name: icon %}
        </span>
        <span>{{ label }}</span>
      </span>
      <span aria-hidden="true">{% render 'fourpattes-header-icon', name: 'arrow' %}</span>
    </a>
  {%- endif -%}
</li>