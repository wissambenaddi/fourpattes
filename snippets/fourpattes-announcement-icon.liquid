{% doc %}
  Renders a lightweight announcement icon using currentColor.
  @param {string} name - truck, package, lock, paw, heart or none.
{% enddoc %}

{%- case name -%}
  {%- when 'truck' -%}
    <svg class="pet-announcement__icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M3 6.5h10.5v9H3zM13.5 9h3.2l3.3 3.4v3.1h-6.5z"/>
      <circle cx="7" cy="17.5" r="1.7"/>
      <circle cx="17.3" cy="17.5" r="1.7"/>
      <path d="M3 15.5h2.3m3.4 0h6.9"/>
    </svg>
  {%- when 'package' -%}
    <svg class="pet-announcement__icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="m4 7.2 8-4 8 4v9.6l-8 4-8-4z"/>
      <path d="m4.4 7.4 7.6 4 7.6-4M12 11.4v9.2M8 5.2l8 4"/>
    </svg>
  {%- when 'lock' -%}
    <svg class="pet-announcement__icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="5" y="10" width="14" height="10" rx="2"/>
      <path d="M8 10V7.5a4 4 0 0 1 8 0V10M12 14v2.5"/>
    </svg>
  {%- when 'paw' -%}
    <svg class="pet-announcement__icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <ellipse cx="12" cy="15.4" rx="4.3" ry="3.5"/>
      <ellipse cx="6.4" cy="11.2" rx="1.8" ry="2.2" transform="rotate(-22 6.4 11.2)"/>
      <ellipse cx="9.4" cy="6.9" rx="1.8" ry="2.2" transform="rotate(-8 9.4 6.9)"/>
      <ellipse cx="14.6" cy="6.9" rx="1.8" ry="2.2" transform="rotate(8 14.6 6.9)"/>
      <ellipse cx="17.6" cy="11.2" rx="1.8" ry="2.2" transform="rotate(22 17.6 11.2)"/>
    </svg>
  {%- when 'heart' -%}
    <svg class="pet-announcement__icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M20.2 8.4c0 5-8.2 10-8.2 10s-8.2-5-8.2-10A4.2 4.2 0 0 1 12 6.9a4.2 4.2 0 0 1 8.2 1.5Z"/>
    </svg>
{%- endcase -%}