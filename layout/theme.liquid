<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.pet_deep_purple }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- assign joined_tags = current_tags | join: ', ' -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} – {{ 'general.meta.tags' | t: tags: joined_tags }}{% endif -%}
      {%- if current_page != 1 %} – {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {{ settings.type_heading_font | font_face: font_display: 'swap' }}

    {% style %}
      :root {
        --pet-page-width: {{ settings.page_width }}px;
        --pet-logo-desktop: {{ settings.logo_width }}px;
        --pet-logo-mobile: {{ settings.logo_width_mobile }}px;
        --pet-font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --pet-font-heading: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
        --pet-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --pet-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --pet-cream: {{ settings.pet_cream }};
        --pet-white: {{ settings.pet_white }};
        --pet-sky-blue: {{ settings.pet_sky_blue }};
        --pet-yellow: {{ settings.pet_yellow }};
        --pet-deep-teal: {{ settings.pet_deep_teal }};
        --pet-turquoise: {{ settings.pet_turquoise }};
        --pet-lime: {{ settings.pet_lime }};
        --pet-deep-purple: {{ settings.pet_deep_purple }};
        --pet-plum: {{ settings.pet_plum }};
        --pet-red-pink: {{ settings.pet_red_pink }};
        --pet-orange: {{ settings.pet_orange }};
        --pet-light-lavender: {{ settings.pet_light_lavender }};
        --pet-light-blue: {{ settings.pet_light_blue }};
        --pet-peach: {{ settings.pet_peach }};
        --pet-text-dark: {{ settings.pet_text_dark }};
      }
    {% endstyle %}

    {{ 'pet-theme.css' | asset_url | stylesheet_tag: preload: true }}
    <script>document.documentElement.classList.remove('no-js');</script>
    <script src="{{ 'pet-theme.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>

  <body class="pet-template-{{ template.name | handle }}">
    <a class="pet-skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="pet-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <p class="pet-visually-hidden" role="status" aria-live="polite" data-pet-live-region></p>
  </body>
</html>
