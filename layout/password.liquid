<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {% render 'typography-system' %}
    {% style %}:root{--pet-cream:{{ settings.pet_cream }};--pet-deep-purple:{{ settings.pet_deep_purple }};--pet-yellow:{{ settings.pet_yellow }};--pet-text-dark:{{ settings.pet_text_dark }};--pet-page-width:1200px}{% endstyle %}
    {{ 'pet-theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>{{ content_for_layout }}</body>
</html>
