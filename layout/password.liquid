<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {% comment %} BEGIN FOURPATTES TYPOGRAPHY {% endcomment %}
    {% # theme-check-disable-next-line RemoteAsset %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    {% # theme-check-disable-next-line RemoteAsset %}
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {% # theme-check-disable-next-line RemoteAsset %}
    <link href="https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Lilita+One&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800;6..12,900&display=swap" rel="stylesheet">
    {% style %}
      :root {
        --font-display: "Lilita One", sans-serif;
        --font-accent: "Caveat Brush", cursive;
        --font-body: "Nunito Sans", sans-serif;
        --pet-font-body: var(--font-body);
        --pet-font-heading: var(--font-display);
        --pet-cream: {{ settings.pet_cream }};
        --pet-deep-purple: {{ settings.pet_deep_purple }};
        --pet-yellow: {{ settings.pet_yellow }};
        --pet-text-dark: {{ settings.pet_text_dark }};
        --pet-page-width: 1200px;
      }
    {% endstyle %}
    {% comment %} END FOURPATTES TYPOGRAPHY {% endcomment %}
    {{ 'pet-theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>{{ content_for_layout }}</body>
</html>
