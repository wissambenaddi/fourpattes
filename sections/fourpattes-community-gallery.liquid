{%- liquid
  assign heading_id = 'CommunityGalleryHeading-' | append: section.id
  assign empty_heading_id = 'CommunityGalleryEmptyHeading-' | append: section.id
  assign visible_content_count = 0

  for block in section.blocks
    if block.type == '@app'
      assign visible_content_count = visible_content_count | plus: 1
    elsif block.settings.consent
      case block.type
        when 'featured_photo', 'photo'
          if block.settings.image != blank
            assign visible_content_count = visible_content_count | plus: 1
          endif
        when 'quote'
          if block.settings.quote != blank
            assign visible_content_count = visible_content_count | plus: 1
          endif
        when 'community_card'
          if block.settings.title != blank or block.settings.text != blank
            assign visible_content_count = visible_content_count | plus: 1
          endif
        when 'video'
          if block.settings.video != blank or block.settings.external_video != blank
            assign visible_content_count = visible_content_count | plus: 1
          endif
      endcase
    endif
  endfor

  assign show_editor_gallery = false
  if request.design_mode and section.blocks.size > 0
    assign show_editor_gallery = true
  endif
-%}

{%- if section.settings.enabled -%}
  <section
    class="pet-community pet-reviews pet-community--desktop-{{ section.settings.desktop_layout }} pet-community--mobile-{{ section.settings.mobile_layout }}{% unless section.settings.enable_animations %} pet-community--static{% endunless %}"
    style="--community-bg: {{ section.settings.background }}; --community-text: {{ section.settings.text_color }}; --community-accent: {{ section.settings.accent_color }}; --community-card: {{ section.settings.card_color }}; --community-soft: {{ section.settings.soft_color }}; --community-max-width: {{ section.settings.max_width }}px; --community-padding-top: {{ section.settings.padding_top }}px; --community-padding-bottom: {{ section.settings.padding_bottom }}px;"
    {% if visible_content_count > 0 %}aria-labelledby="{{ heading_id }}"{% else %}aria-labelledby="{{ empty_heading_id }}"{% endif %}
    data-pet-reveal
  >
    {%- if section.settings.show_top_wave -%}
      {% render 'wave-divider', color: section.settings.background, position: 'top', flip: section.settings.flip_top_wave %}
    {%- endif -%}

    {%- if request.page_type == 'index' -%}
      {% render 'homepage-flow-link', kind: 'life-reviews' %}
    {%- endif -%}

    {%- if section.settings.show_decorations -%}
      <div class="pet-community__decor" aria-hidden="true">
        <span class="pet-community__decor-paw pet-community__decor-paw--one">{% render 'icon-paw' %}</span>
        <span class="pet-community__decor-paw pet-community__decor-paw--two">{% render 'icon-paw' %}</span>
        <span class="pet-community__decor-heart">♡</span>
        <span class="pet-community__decor-star pet-community__decor-star--one">✦</span>
        <span class="pet-community__decor-star pet-community__decor-star--two">✧</span>
        <svg class="pet-community__decor-camera" viewBox="0 0 64 52" focusable="false">
          <path d="M7 14h12l5-7h17l5 7h11v32H7z"/>
          <circle cx="32" cy="30" r="11"/>
          <path d="M50 20h2"/>
        </svg>
      </div>
    {%- endif -%}

    <div class="pet-shell pet-community__shell">
      {%- if visible_content_count > 0 -%}
        <header class="pet-community__header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="pet-community__eyebrow"><span aria-hidden="true">🐾</span>{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}<h2 id="{{ heading_id }}">{{ section.settings.title | escape | newline_to_br }}</h2>{%- endif -%}
          {%- if section.settings.subtitle != blank -%}<p class="pet-community__subtitle">{{ section.settings.subtitle | escape }}</p>{%- endif -%}
        </header>

        <div class="pet-community__gallery" role="region" aria-label="{{ section.settings.gallery_label | escape }}">
          {%- for mobile_position in (1..12) -%}
            {%- for block in section.blocks -%}
              {%- if block.type != '@app' and block.settings.mobile_order == mobile_position -%}
                {% render 'community-gallery-item', block: block %}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}

          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              <div class="pet-community-item pet-community-item--app" {{ block.shopify_attributes }}>
                {% render block %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.show_participation -%}
          <aside class="pet-community__participation">
            <span class="pet-community__participation-icon" aria-hidden="true">♡</span>
            <div>
              {%- if section.settings.participation_title != blank -%}<h3>{{ section.settings.participation_title | escape }}</h3>{%- endif -%}
              {%- if section.settings.participation_text != blank -%}<p>{{ section.settings.participation_text | escape }}</p>{%- endif -%}
            </div>
            <div class="pet-community__actions">
              {%- if section.settings.button_label != blank -%}
                <a class="pet-button{% if section.settings.button_style == 'outline' %} pet-button--outline{% endif %}" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
              {%- endif -%}
              {%- if section.settings.secondary_link_label != blank and section.settings.secondary_link != blank -%}
                <a class="pet-community__secondary-link" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_link_label | escape }} <span aria-hidden="true">→</span></a>
              {%- endif -%}
            </div>
          </aside>
        {%- endif -%}
      {%- else -%}
        <div class="pet-community__empty">
          <span class="pet-community__empty-illustration" aria-hidden="true">
            <span>🐶</span><span>📷</span><span>🐱</span>
          </span>
          {%- if section.settings.empty_eyebrow != blank -%}<p class="pet-community__eyebrow">{{ section.settings.empty_eyebrow | escape }}</p>{%- endif -%}
          <h2 id="{{ empty_heading_id }}">{{ section.settings.empty_title | escape }}</h2>
          {%- if section.settings.empty_text != blank -%}<p>{{ section.settings.empty_text | escape }}</p>{%- endif -%}
          {%- if section.settings.empty_button_label != blank -%}
            <a class="pet-button" href="{{ section.settings.empty_button_link | default: routes.all_products_collection_url }}">{{ section.settings.empty_button_label | escape }}</a>
          {%- endif -%}
        </div>

        {%- if show_editor_gallery -%}
          <div class="pet-community__editor-preview" aria-label="{{ 'community.editor_preview' | t }}">
            {%- for mobile_position in (1..12) -%}
              {%- for block in section.blocks -%}
                {%- if block.type != '@app' and block.settings.mobile_order == mobile_position -%}
                  {% render 'community-gallery-item', block: block %}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_bottom_wave -%}
      {% render 'wave-divider', color: section.settings.bottom_color, position: 'bottom', flip: section.settings.flip_bottom_wave %}
    {%- endif -%}
  </section>

  {{ 'fourpattes-community-gallery.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{% schema %}
{
  "name": "Galerie de la meute",
  "tag": "section",
  "class": "pet-community-section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Afficher la section", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Petit badge", "default": "LA COMMUNAUTÉ FOURPATTES" },
    { "type": "textarea", "id": "title", "label": "Titre", "default": "ILS FONT DÉJÀ PARTIE DE LA MEUTE" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Des moments de jeu, de surprise et de complicité partagés par notre communauté." },
    { "type": "text", "id": "gallery_label", "label": "Libellé accessible de la galerie", "default": "Photos et histoires de la communauté FourPattes" },

    { "type": "header", "content": "Composition" },
    { "type": "select", "id": "desktop_layout", "label": "Disposition ordinateur", "options": [{ "value": "mosaic", "label": "Mosaïque organique" }, { "value": "editorial", "label": "Grille éditoriale" }], "default": "mosaic" },
    { "type": "select", "id": "mobile_layout", "label": "Disposition mobile", "options": [{ "value": "carousel", "label": "Défilement horizontal" }, { "value": "grid", "label": "Grille deux colonnes" }], "default": "carousel" },
    { "type": "range", "id": "max_width", "min": 1000, "max": 1300, "step": 20, "unit": "px", "label": "Largeur maximale", "default": 1160 },
    { "type": "range", "id": "padding_top", "min": 40, "max": 120, "step": 4, "unit": "px", "label": "Espace supérieur", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 40, "max": 120, "step": 4, "unit": "px", "label": "Espace inférieur", "default": 84 },
    { "type": "checkbox", "id": "enable_animations", "label": "Activer les animations", "default": true },
    { "type": "checkbox", "id": "show_decorations", "label": "Afficher les décorations", "default": true },

    { "type": "header", "content": "Appel à participation" },
    { "type": "checkbox", "id": "show_participation", "label": "Afficher l’appel", "default": true },
    { "type": "text", "id": "participation_title", "label": "Titre de l’appel", "default": "Votre compagnon pourrait être le prochain" },
