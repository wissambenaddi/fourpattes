    { "type": "color", "id": "text_color", "label": "Texte", "default": "#2D1C63" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C82552" },
    { "type": "color", "id": "card_color", "label": "Cartes", "default": "#FFF9F4" },
    { "type": "color", "id": "soft_color", "label": "Décor doux", "default": "#BFE2F3" },

    { "type": "header", "content": "Vagues" },
    { "type": "checkbox", "id": "show_top_wave", "label": "Afficher la vague supérieure", "default": false },
    { "type": "checkbox", "id": "flip_top_wave", "label": "Inverser la vague supérieure", "default": false },
    { "type": "checkbox", "id": "show_bottom_wave", "label": "Afficher la vague inférieure", "default": false },
    { "type": "color", "id": "bottom_color", "label": "Couleur après la vague", "default": "#702758" },
    { "type": "checkbox", "id": "flip_bottom_wave", "label": "Inverser la vague inférieure", "default": false }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "featured_photo",
