    { "type": "text", "id": "secondary_link_label", "label": "Texte du lien secondaire", "default": "Voir tous les avis" },
    { "type": "url", "id": "secondary_link", "label": "Lien secondaire" },

    { "type": "header", "content": "État sans contenu réel" },
    { "type": "text", "id": "empty_eyebrow", "label": "Petit badge vide", "default": "LA MEUTE COMMENCE ICI" },
    { "type": "text", "id": "empty_title", "label": "Titre vide", "default": "Votre compagnon pourrait être le premier" },
