        { "type": "text", "id": "credit", "label": "Crédit facultatif" },
        { "type": "url", "id": "source_link", "label": "Publication source" },
        { "type": "url", "id": "review_link", "label": "Avis associé" },
        { "type": "select", "id": "desktop_position", "label": "Position ordinateur", "options": [{ "value": "main", "label": "Centre principal" }, { "value": "top-left", "label": "Haut gauche" }, { "value": "top-right", "label": "Haut droite" }, { "value": "bottom-left", "label": "Bas gauche" }, { "value": "bottom-center", "label": "Bas centre" }, { "value": "bottom-right", "label": "Bas droite" }, { "value": "auto", "label": "Automatique" }], "default": "main" },
        { "type": "select", "id": "desktop_size", "label": "Taille ordinateur", "options": [{ "value": "small", "label": "Petite" }, { "value": "medium", "label": "Moyenne" }, { "value": "large", "label": "Grande" }, { "value": "wide", "label": "Horizontale" }], "default": "large" },
        { "type": "range", "id": "rotation", "min": -3, "max": 3, "step": 1, "unit": "°", "label": "Rotation ordinateur", "default": -1 },
        { "type": "range", "id": "mobile_order", "min": 1, "max": 12, "step": 1, "label": "Ordre mobile", "default": 1 },
