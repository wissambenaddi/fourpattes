<section
  class="pet-newsletter"
  style="--newsletter-bg: {{ section.settings.background }}; --newsletter-card: {{ section.settings.card_background }}; --newsletter-color: {{ section.settings.text_color }};"
  data-pet-reveal
>
  <div class="pet-shell">
    <div class="pet-newsletter__card">
      {%- if section.settings.show_animals -%}
        <span class="pet-newsletter__visual pet-newsletter__visual--left" aria-hidden="true">
          {%- if section.settings.decoration_left != blank -%}
            {{ section.settings.decoration_left | image_url: width: 600 | image_tag: widths: '180, 280, 420, 600', sizes: '(max-width: 749px) 86px, 150px', class: 'pet-newsletter__visual-image', loading: 'lazy', alt: '' }}
          {%- else -%}
            <img class="pet-newsletter__visual-image" src="{{ 'mascotte-fourpattes-bandana.webp' | asset_url }}" width="863" height="1027" loading="lazy" alt="">
          {%- endif -%}
        </span>
        <span class="pet-newsletter__visual pet-newsletter__visual--right" aria-hidden="true">
          {%- if section.settings.decoration_right != blank -%}
            {{ section.settings.decoration_right | image_url: width: 700 | image_tag: widths: '180, 280, 420, 600, 700', sizes: '(max-width: 749px) 104px, 180px', class: 'pet-newsletter__visual-image', loading: 'lazy', alt: '' }}
          {%- else -%}
            <img class="pet-newsletter__visual-image" src="{{ 'accessoires-newsletter-fourpattes.webp' | asset_url }}" width="1050" height="982" loading="lazy" alt="">
          {%- endif -%}
        </span>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}<p class="pet-newsletter__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.title | escape }}</h2>
      <div class="pet-newsletter__text">{{ section.settings.text }}</div>
      {%- if section.settings.reassurance != blank -%}<p class="pet-newsletter__reassurance"><span aria-hidden="true">✓</span> {{ section.settings.reassurance | escape }}</p>{%- endif -%}

      {%- form 'customer', class: 'pet-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="pet-visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
        <div class="pet-newsletter__field">
          <input
            id="NewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            placeholder="{{ section.settings.placeholder | escape }}"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% endif %}
          >
          <button type="submit" aria-label="{{ section.settings.button_label | escape }}">{% render 'pet-icon', name: 'arrow' %}</button>
        </div>
        {%- if form.errors -%}
          <div class="pet-form-message pet-form-message--error" id="NewsletterError-{{ section.id }}" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <p class="pet-form-message" role="status">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter Fourpattes",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "REJOIGNEZ LA MEUTE" },
    { "type": "text", "id": "eyebrow", "label": "Petit texte", "default": "DES NOUVELLES QUI FONT REMUER LA QUEUE" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Des nouveautés, des conseils et un peu de joie dans votre boîte mail.</p>" },
    { "type": "text", "id": "reassurance", "label": "Réassurance", "default": "Conseils utiles, nouveautés et offres — jamais de spam" },
    { "type": "text", "id": "placeholder", "label": "Texte du champ", "default": "Votre adresse e-mail" },
    { "type": "text", "id": "button_label", "label": "Libellé du bouton", "default": "Je m’inscris" },
    { "type": "checkbox", "id": "show_animals", "label": "Afficher les décorations", "default": true },
    { "type": "image_picker", "id": "decoration_left", "label": "Décoration gauche" },
    { "type": "image_picker", "id": "decoration_right", "label": "Décoration droite" },
    { "type": "color", "id": "background", "label": "Fond de section", "default": "#F9F0EB" },
    { "type": "color", "id": "card_background", "label": "Fond de la carte", "default": "#E9D9F7" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#2D1C63" }
  ],
  "presets": [{ "name": "Newsletter Fourpattes" }]
}
{% endschema %}
