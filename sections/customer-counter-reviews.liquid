{%- liquid
  assign heading_id = 'SocialProofHeading-' | append: section.id
  assign featured_review = section.blocks | first
-%}

<section
  class="pet-reviews pet-reviews--social-proof"
  style="--reviews-bg: {{ section.settings.background }}; --reviews-color: {{ section.settings.text_color }}; --reviews-card: {{ section.settings.card_background }}; --reviews-accent: {{ section.settings.accent_color }}; --reviews-highlight: {{ section.settings.highlight_color }};"
  {% if section.settings.title != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
  data-pet-reveal
>
  {%- if request.page_type == 'index' -%}{% render 'homepage-flow-link', kind: 'life-reviews' %}{%- endif -%}

  <div class="pet-social-proof__decor" aria-hidden="true">
    <span class="pet-social-proof__decor-paw">{% render 'icon-paw' %}</span>
    <span class="pet-social-proof__decor-heart">♡</span>
    <span class="pet-social-proof__decor-star">✦</span>
  </div>

  <div class="pet-shell pet-social-proof">
    <header class="pet-social-proof__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pet-social-proof__badge"><span aria-hidden="true">♥</span>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 id="{{ heading_id }}">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="pet-social-proof__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </header>

    <div class="pet-social-proof__metric">
      <strong class="pet-social-proof__number" data-pet-counter="{{ section.settings.counter | escape }}">{{ section.settings.counter | escape }}</strong>
      <p class="pet-social-proof__metric-label">{{ section.settings.counter_label | escape }}</p>
      {%- if section.settings.counter_context != blank -%}<small>{{ section.settings.counter_context | escape }}</small>{%- endif -%}
    </div>

    {%- if section.settings.trust_rating != blank or section.settings.trust_count != blank or section.settings.reassurance != blank -%}
      <div class="pet-social-proof__trust" role="group" aria-label="{{ section.settings.trust_accessibility_label | escape }}">
        {%- if section.settings.trust_rating != blank -%}
          <span class="pet-social-proof__trust-stars" aria-hidden="true">★★★★★</span>
          <strong>{{ section.settings.trust_rating | escape }}/5</strong>
        {%- else -%}
          <span class="pet-social-proof__trust-paw" aria-hidden="true">{% render 'icon-paw' %}</span>
        {%- endif -%}
        {%- if section.settings.trust_count != blank -%}<span>{{ section.settings.trust_count | escape }}</span>{%- endif -%}
        {%- if section.settings.reassurance != blank -%}<span>{{ section.settings.reassurance | escape }}</span>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if featured_review != blank -%}
      <div class="pet-social-proof__story">
        <div class="pet-social-proof__featured">
          {% render 'social-proof-review-card', block: featured_review, featured: true, fallback_index: 0, verified_label: section.settings.verified_label, illustrative_label: section.settings.illustrative_label %}
        </div>

        {%- if section.blocks.size > 1 -%}
          <div class="pet-social-proof__secondary" role="region" data-pet-carousel aria-label="{{ section.settings.carousel_label | escape }}">
            {%- for block in section.blocks offset: 1 -%}
              {% render 'social-proof-review-card', block: block, featured: false, fallback_index: forloop.index, verified_label: section.settings.verified_label, illustrative_label: section.settings.illustrative_label %}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 2 -%}
      <div class="pet-carousel-controls pet-reviews__controls pet-social-proof__controls">
        <button class="pet-icon-button" type="button" aria-label="{{ 'accessibility.previous' | t }}" data-pet-carousel-prev>←</button>
        <button class="pet-icon-button" type="button" aria-label="{{ 'accessibility.next' | t }}" data-pet-carousel-next>→</button>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="pet-social-proof__action">
        <a class="pet-button pet-social-proof__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          <span>{{ section.settings.button_label | escape }}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{{ 'social-proof-premium.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Preuve sociale premium",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Badge", "default": "LA MEUTE FOURPATTES" },
    { "type": "text", "id": "title", "label": "Titre", "default": "ILS FONT DÉJÀ PARTIE DE LA MEUTE" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Des histoires de complicité partagées par notre communauté." },
    { "type": "text", "id": "counter", "label": "Compteur", "default": "2963057" },
    { "type": "text", "id": "counter_label", "label": "Libellé du compteur", "default": "CHIENS ET CHATS HEUREUX" },
    { "type": "text", "id": "counter_context", "label": "Contexte du compteur", "default": "depuis le début de l’aventure" },
    { "type": "header", "content": "Preuve de confiance" },
    { "type": "text", "id": "trust_rating", "label": "Note moyenne vérifiée", "info": "Laisser vide si cette donnée n’est pas vérifiée." },
    { "type": "text", "id": "trust_count", "label": "Volume d’avis vérifié", "info": "Exemple : Basé sur 12 000 avis. Laisser vide si non vérifié." },
    { "type": "text", "id": "reassurance", "label": "Phrase de réassurance", "default": "Des témoignages partagés par notre communauté" },
    { "type": "text", "id": "trust_accessibility_label", "label": "Libellé accessible de la preuve", "default": "Preuve de confiance FourPattes" },
    { "type": "text", "id": "verified_label", "label": "Badge client vérifié", "default": "Client vérifié" },
    { "type": "text", "id": "illustrative_label", "label": "Badge photo illustrative", "default": "Photo illustrative" },
    { "type": "text", "id": "carousel_label", "label": "Libellé accessible des avis", "default": "Témoignages de la communauté" },
    { "type": "header", "content": "Appel à l’action" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "REJOINDRE LA MEUTE" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#F9F0EB" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#2D1C63" },
    { "type": "color", "id": "card_background", "label": "Fond des cartes", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D51F5C" },
    { "type": "color", "id": "highlight_color", "label": "Étoiles", "default": "#F3A72C" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis client",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif", "default": "Client avec son animal" },
        { "type": "checkbox", "id": "photo_is_illustrative", "label": "Afficher le badge photo illustrative", "default": false },
        { "type": "textarea", "id": "quote", "label": "Avis", "default": "Avis de démonstration — à remplacer par un avis client vérifié." },
        { "type": "text", "id": "name", "label": "Prénom du client", "default": "Prénom du client" },
        { "type": "text", "id": "animal_name", "label": "Nom de l’animal" },
        { "type": "text", "id": "city", "label": "Ville" },
        { "type": "text", "id": "review_date", "label": "Date affichée" },
        { "type": "checkbox", "id": "verified", "label": "Avis vérifié", "default": false, "info": "Activer uniquement si l’avis a réellement été vérifié." },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Note", "default": 5 },
        { "type": "product", "id": "product", "label": "Produit acheté" },
        { "type": "range", "id": "rotation", "min": -6, "max": 6, "step": 1, "unit": "°", "label": "Rotation secondaire", "default": 0 }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Preuve sociale premium", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
