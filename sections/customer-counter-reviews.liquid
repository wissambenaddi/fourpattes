<section
  class="pet-reviews"
  style="--reviews-bg: {{ section.settings.background }}; --reviews-color: {{ section.settings.text_color }};"
  data-pet-reveal
>
  <div class="pet-shell">
    <header class="pet-counter">
      {%- if section.settings.eyebrow != blank -%}<span class="pet-counter__eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <strong class="pet-counter__number" data-pet-counter="{{ section.settings.counter | escape }}">{{ section.settings.counter | escape }}</strong>
      <h2>{{ section.settings.counter_label | escape }}</h2>
      {%- if section.settings.reassurance != blank -%}<p class="pet-counter__reassurance"><span aria-hidden="true">♥</span> {{ section.settings.reassurance | escape }}</p>{%- endif -%}
    </header>

    <div class="pet-review-carousel" data-pet-carousel>
      {%- for block in section.blocks -%}
        <article class="pet-review-card" style="--review-rotation: {{ block.settings.rotation }}deg" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {% render 'responsive-image', image: block.settings.image, alt: block.settings.image_alt, class: 'pet-review-card__image', sizes: '(max-width: 749px) 72vw, 280px' %}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'pet-review-card__image pet-review-card__placeholder' }}
          {%- endif -%}
          <div class="pet-review-card__body">
            <div class="pet-review-card__stars" aria-label="{{ block.settings.rating }} sur 5">
              {%- for i in (1..5) -%}<span aria-hidden="true">{% if i <= block.settings.rating %}★{% else %}☆{% endif %}</span>{%- endfor -%}
            </div>
            <blockquote>{{ block.settings.quote | escape }}</blockquote>
            <p class="pet-review-card__author">— {{ block.settings.name | escape }}</p>
            {%- if block.settings.product != blank -%}<a href="{{ block.settings.product.url }}">{{ block.settings.product.title }}</a>{%- endif -%}
          </div>
        </article>
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="pet-review-card" style="--review-rotation: 0deg">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'pet-review-card__image pet-review-card__placeholder' }}
            <div class="pet-review-card__body"><div class="pet-review-card__stars" aria-label="5 sur 5">★★★★★</div><blockquote>Avis de démonstration — remplacez ce texte par un avis client vérifié.</blockquote><p class="pet-review-card__author">— Prénom du client</p></div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    <div class="pet-carousel-controls pet-reviews__controls">
      <button class="pet-icon-button" type="button" aria-label="{{ 'accessibility.previous' | t }}" data-pet-carousel-prev>←</button>
      <button class="pet-icon-button" type="button" aria-label="{{ 'accessibility.next' | t }}" data-pet-carousel-next>→</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Compteur et avis",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Petit texte", "default": "DÉJÀ" },
    { "type": "text", "id": "counter", "label": "Compteur", "default": "2963057" },
    { "type": "text", "id": "counter_label", "label": "Libellé", "default": "CHIENS ET CHATS HEUREUX" },
    { "type": "text", "id": "reassurance", "label": "Phrase de réassurance", "default": "Des produits choisis avec soin pour leur bien-être" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#F9F0EB" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#2D1C63" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis client",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif", "default": "Client avec son animal" },
        { "type": "textarea", "id": "quote", "label": "Avis", "default": "Avis de démonstration — à remplacer par un avis client vérifié." },
        { "type": "text", "id": "name", "label": "Nom", "default": "Prénom du client" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Note", "default": 5 },
        { "type": "product", "id": "product", "label": "Produit acheté" },
        { "type": "range", "id": "rotation", "min": -6, "max": 6, "step": 1, "unit": "°", "label": "Rotation", "default": 0 }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Compteur et avis", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
