{%- liquid
  assign use_brand_scene = false
  if section.settings.dog_image == blank and section.settings.cat_image == blank
    assign use_brand_scene = true
  endif
-%}

<section
  class="pet-hero{% if use_brand_scene %} pet-hero--brand-scene{% endif %}"
  style="
    --hero-bg: {{ section.settings.background }};
    --hero-color: {{ section.settings.text_color }};
    --hero-min-mobile: {{ section.settings.height_mobile }}px;
    --hero-min-desktop: {{ section.settings.height_desktop }}px;
    --dog-width: {{ section.settings.dog_width }}%;
    --dog-x: {{ section.settings.dog_x }}%;
    --dog-y: {{ section.settings.dog_y }}%;
    --cat-width: {{ section.settings.cat_width }}%;
    --cat-x: {{ section.settings.cat_x }}%;
    --cat-y: {{ section.settings.cat_y }}%;
  "
  data-pet-reveal
>
  {%- if use_brand_scene -%}
    <div class="pet-hero__brand-scene" aria-hidden="true">
      <img class="pet-hero__brand-image" src="{{ 'fourpattes-hero.webp' | asset_url }}" width="1672" height="941" loading="eager" fetchpriority="high" alt="">
    </div>
    <span class="pet-hero__mobile-scene pet-hero__mobile-scene--dog" style="--pet-scene-url: url('{{ 'fourpattes-hero.webp' | asset_url }}')" aria-hidden="true"></span>
    <span class="pet-hero__mobile-scene pet-hero__mobile-scene--cat" style="--pet-scene-url: url('{{ 'fourpattes-hero.webp' | asset_url }}')" aria-hidden="true"></span>
  {%- endif -%}

  {%- if section.settings.decorations -%}
    <span class="pet-hero__scribble pet-hero__scribble--one" aria-hidden="true">✦</span>
    <span class="pet-hero__scribble pet-hero__scribble--two" aria-hidden="true">♡</span>
    <span class="pet-hero__scribble pet-hero__scribble--three" aria-hidden="true">⌁</span>
    <span class="pet-hero__scribble pet-hero__scribble--four" aria-hidden="true">✧</span>
    <span class="pet-hero__scribble pet-hero__scribble--paw" aria-hidden="true">{% render 'icon-paw' %}</span>
  {%- endif -%}

  {%- unless use_brand_scene -%}
    <div class="pet-hero__animal pet-hero__animal--dog">
      {%- if section.settings.dog_image != blank -%}
        {% render 'responsive-image', image: section.settings.dog_image, alt: section.settings.dog_alt, class: 'pet-hero__animal-image', sizes: '(max-width: 749px) 55vw, 40vw', priority: true %}
      {%- else -%}
        <div class="pet-hero__animal-placeholder pet-hero__animal-placeholder--dog" role="img" aria-label="{{ section.settings.dog_alt | escape }}">{% render 'icon-dog' %}</div>
      {%- endif -%}
    </div>
  {%- endunless -%}

  <div class="pet-shell pet-hero__inner">
    <div class="pet-hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="pet-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="pet-hero__title">{{ section.settings.title | escape | newline_to_br }}</h1>
      {%- if section.settings.subtitle != blank -%}<p class="pet-hero__subtitle">{{ section.settings.subtitle | escape }}</p>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="pet-hero__text">{{ section.settings.text }}</div>{%- endif -%}
      <div class="pet-button-row">
        {%- if section.settings.button_dog_label != blank -%}<a class="pet-button" href="{{ section.settings.button_dog_link | default: routes.all_products_collection_url }}">{{ section.settings.button_dog_label | escape }}</a>{%- endif -%}
        {%- if section.settings.button_cat_label != blank -%}<a class="pet-button" href="{{ section.settings.button_cat_link | default: routes.all_products_collection_url }}">{{ section.settings.button_cat_label | escape }}</a>{%- endif -%}
      </div>
    </div>
  </div>

  {%- unless use_brand_scene -%}
    <div class="pet-hero__animal pet-hero__animal--cat">
      {%- if section.settings.cat_image != blank -%}
        {% render 'responsive-image', image: section.settings.cat_image, alt: section.settings.cat_alt, class: 'pet-hero__animal-image', sizes: '(max-width: 749px) 52vw, 38vw', priority: true %}
      {%- else -%}
        <div class="pet-hero__animal-placeholder pet-hero__animal-placeholder--cat" role="img" aria-label="{{ section.settings.cat_alt | escape }}">{% render 'icon-cat' %}</div>
      {%- endif -%}
    </div>
  {%- endunless -%}
</section>

{% schema %}
{
  "name": "Hero animaux",
  "tag": "section",
  "class": "pet-hero-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Petit texte", "default": "HEY COUCOU !" },
    { "type": "textarea", "id": "title", "label": "Titre", "default": "LE BONHEUR COMMENCE À QUATRE PATTES" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "ACCESSOIRES JOYEUX POUR CHIENS ET CHATS" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Des accessoires joyeux pour prendre soin de vos compagnons.</p>" },
    { "type": "text", "id": "button_dog_label", "label": "Bouton chiens", "default": "Accessoires chien" },
    { "type": "url", "id": "button_dog_link", "label": "Lien chiens" },
    { "type": "text", "id": "button_cat_label", "label": "Bouton chats", "default": "Accessoires chat" },
    { "type": "url", "id": "button_cat_link", "label": "Lien chats" },
    { "type": "image_picker", "id": "dog_image", "label": "Image du chien détourée" },
    { "type": "text", "id": "dog_alt", "label": "Texte alternatif du chien", "default": "Chien heureux" },
    { "type": "range", "id": "dog_width", "min": 25, "max": 65, "step": 1, "unit": "%", "label": "Taille du chien", "default": 54 },
    { "type": "range", "id": "dog_x", "min": -20, "max": 20, "step": 1, "unit": "%", "label": "Position horizontale du chien", "default": -5 },
    { "type": "range", "id": "dog_y", "min": -15, "max": 25, "step": 1, "unit": "%", "label": "Position verticale du chien", "default": 4 },
    { "type": "image_picker", "id": "cat_image", "label": "Image du chat détourée" },
    { "type": "text", "id": "cat_alt", "label": "Texte alternatif du chat", "default": "Chat curieux" },
    { "type": "range", "id": "cat_width", "min": 25, "max": 65, "step": 1, "unit": "%", "label": "Taille du chat", "default": 50 },
    { "type": "range", "id": "cat_x", "min": -20, "max": 20, "step": 1, "unit": "%", "label": "Position horizontale du chat", "default": -4 },
    { "type": "range", "id": "cat_y", "min": -15, "max": 25, "step": 1, "unit": "%", "label": "Position verticale du chat", "default": 5 },
    { "type": "color", "id": "background", "label": "Fond", "default": "#B7E3FB" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#2D1C63" },
    { "type": "range", "id": "height_mobile", "min": 380, "max": 760, "step": 20, "unit": "px", "label": "Hauteur mobile", "default": 560 },
    { "type": "range", "id": "height_desktop", "min": 500, "max": 900, "step": 20, "unit": "px", "label": "Hauteur ordinateur", "default": 620 },
    { "type": "checkbox", "id": "decorations", "label": "Afficher les décorations", "default": true }
  ],
  "presets": [{ "name": "Hero animaux" }]
}
{% endschema %}
