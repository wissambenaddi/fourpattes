{%- liquid
  assign use_brand_scene = false
  if section.settings.dog_image == blank and section.settings.cat_image == blank
    assign use_brand_scene = true
  endif

  assign brand_desktop_asset = 'fourpattes-hero-conversation-desktop.webp'
  assign brand_mobile_asset = 'fourpattes-hero-conversation-mobile.webp'
-%}

<section
  class="pet-hero{% if use_brand_scene %} pet-hero--brand-scene{% endif %}"
  style="
    --hero-bg: {{ section.settings.background }};
    --hero-color: {{ section.settings.text_color }};
    --hero-min-mobile: {{ section.settings.height_mobile }}px;
    --hero-min-desktop: {{ section.settings.height_desktop }}px;
    --dog-width: {{ section.settings.dog_width }}%;
    --dog-x: {{ section.settings.dog_x }}%;
    --dog-y: {{ section.settings.dog_y }}%;
    --cat-width: {{ section.settings.cat_width }}%;
    --cat-x: {{ section.settings.cat_x }}%;
    --cat-y: {{ section.settings.cat_y }}%;
    --dialogue-dog-x: {{ section.settings.dog_dialogue_x }}%;
    --dialogue-dog-y: {{ section.settings.dog_dialogue_y }}%;
    --dialogue-cat-x: {{ section.settings.cat_dialogue_x }}%;
    --dialogue-cat-y: {{ section.settings.cat_dialogue_y }}%;
    --dialogue-bubble-bg: {{ section.settings.dialogue_bubble_background }};
    --dialogue-bubble-border: {{ section.settings.dialogue_bubble_border }};
    --dialogue-bubble-text: {{ section.settings.dialogue_bubble_text }};
    --trust-capsule-bg: {{ section.settings.trust_background_color }};
    --trust-capsule-text: {{ section.settings.trust_text_color }};
    --trust-capsule-star: {{ section.settings.trust_star_color }};
    --trust-capsule-accent: {{ section.settings.trust_accent_color }};
    --trust-capsule-font-size: {{ section.settings.trust_font_size }}px;
  "
  data-pet-reveal
  {% if section.settings.enable_animated_dialogue %}
    data-animated-dialogue
  {% endif %}
>
  {%- if use_brand_scene -%}
    <picture class="pet-hero__brand-scene pet-hero__brand-scene--conversation">
      {%- if section.settings.hero_mobile_image != blank -%}
        <source media="(max-width: 749px)" srcset="{{ section.settings.hero_mobile_image | image_url: width: 1200 }}">
      {%- else -%}
        <source media="(max-width: 749px)" srcset="{{ brand_mobile_asset | asset_url }}">
      {%- endif -%}
      {%- if section.settings.hero_desktop_image != blank -%}
        {{ section.settings.hero_desktop_image | image_url: width: 2400 | image_tag: class: 'pet-hero__brand-image', widths: '960, 1200, 1600, 1920, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_image_alt }}
      {%- else -%}
        <img class="pet-hero__brand-image" src="{{ brand_desktop_asset | asset_url }}" width="2400" height="1350" loading="eager" fetchpriority="high" alt="{{ section.settings.hero_image_alt | escape }}">
      {%- endif -%}
    </picture>
  {%- endif -%}

  {%- if section.settings.enable_animated_dialogue -%}
    <div class="pet-hero__dialogues">
      <div class="pet-hero-dialogue pet-hero-dialogue--dog">
        <span class="pet-visually-hidden">Le chien dit :</span>
        <p class="pet-hero-dialogue__text">{{ section.settings.dog_dialogue | escape }}</p>
        <span class="pet-hero-dialogue__reaction pet-hero-dialogue__reaction--dog">{{ section.settings.dog_reaction | escape }}</span>
        <span class="pet-hero-dialogue__tail" aria-hidden="true"></span>
        <span class="pet-hero-dialogue__accent pet-hero-dialogue__accent--dog" aria-hidden="true">〰</span>
      </div>

      <div class="pet-hero-dialogue pet-hero-dialogue--cat">
        <span class="pet-visually-hidden">Le chat répond :</span>
        <p class="pet-hero-dialogue__text">{{ section.settings.cat_dialogue | escape }}</p>
        <span class="pet-hero-dialogue__reaction pet-hero-dialogue__reaction--cat">{{ section.settings.cat_reaction | escape }}</span>
        <span class="pet-hero-dialogue__tail" aria-hidden="true"></span>
        <span class="pet-hero-dialogue__accent pet-hero-dialogue__accent--cat" aria-hidden="true">♡</span>
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.decorations -%}
    {%- unless use_brand_scene -%}
      <span class="pet-hero__scribble pet-hero__scribble--one" aria-hidden="true">✦</span>
      <span class="pet-hero__scribble pet-hero__scribble--two" aria-hidden="true">♡</span>
      <span class="pet-hero__scribble pet-hero__scribble--three" aria-hidden="true">⌁</span>
      <span class="pet-hero__scribble pet-hero__scribble--four" aria-hidden="true">✧</span>
      <span class="pet-hero__scribble pet-hero__scribble--paw" aria-hidden="true">{% render 'icon-paw' %}</span>
    {%- endunless -%}
  {%- endif -%}

  {%- unless use_brand_scene -%}
    <div class="pet-hero__animal pet-hero__animal--dog">
      {%- if section.settings.dog_image != blank -%}
        {% render 'responsive-image', image: section.settings.dog_image, alt: section.settings.dog_alt, class: 'pet-hero__animal-image', sizes: '(max-width: 749px) 55vw, 40vw', priority: true %}
      {%- else -%}
        <div class="pet-hero__animal-placeholder pet-hero__animal-placeholder--dog" role="img" aria-label="{{ section.settings.dog_alt | escape }}">{% render 'icon-dog' %}</div>
      {%- endif -%}
    </div>
  {%- endunless -%}

  <div class="pet-shell pet-hero__inner">
    <div class="pet-hero__content">
      <p class="pet-hero__yooo">EH OUI !</p>
      {%- assign narrator_lines = section.settings.title | newline_to_br | split: '<br />' -%}
      <h1 class="pet-hero__title">
        {%- for narrator_line in narrator_lines -%}
          <span class="pet-hero__title-line{% if forloop.last %} pet-hero__title-line--emphasis{% endif %}">{{ narrator_line | strip | escape }}</span>
        {%- endfor -%}
      </h1>

      {%- comment -%}
        Secondary trust signal: all commercial values and colors are editable
        in the Hero settings. The capsule becomes a single accessible link only
        when a review page URL is configured.
      {%- endcomment -%}
      {%- if section.settings.trust_enabled -%}
        <div class="pet-hero__trust-slot">
          {%- if section.settings.trust_link != blank -%}
            <a class="pet-hero-trust" href="{{ section.settings.trust_link }}">
          {%- else -%}
            <div class="pet-hero-trust">
          {%- endif -%}
              {%- if section.settings.trust_heading != blank -%}
                <span class="pet-hero-trust__heading">{{ section.settings.trust_heading | escape }}</span>
              {%- endif -%}

              <span class="pet-hero-trust__score">
                <span
                  class="pet-hero-trust__stars"
                  role="img"
                  aria-label="{{ section.settings.trust_stars_aria_label | escape }}"
                >
                  {%- for star in (1..5) -%}
                    <span class="pet-hero-trust__star" aria-hidden="true">★</span>
                  {%- endfor -%}
                </span>
                {%- if section.settings.trust_rating != blank -%}
                  <strong class="pet-hero-trust__rating">{{ section.settings.trust_rating | escape }}</strong>
                {%- endif -%}
              </span>

              {%- if section.settings.trust_reviews_count != blank -%}
                <span class="pet-hero-trust__separator" aria-hidden="true"></span>
                <span class="pet-hero-trust__reviews">
                  <strong>{{ section.settings.trust_reviews_count | escape }}</strong>
                  {{ section.settings.trust_reviews_label | escape }}
                </span>
              {%- endif -%}

              {%- if section.settings.trust_boxes_count != blank -%}
                <span class="pet-hero-trust__separator" aria-hidden="true"></span>
                <span class="pet-hero-trust__boxes">
                  <svg class="pet-hero-trust__parcel" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M4.5 7.5 12 3l7.5 4.5v9L12 21l-7.5-4.5v-9Z"/>
                    <path d="m4.8 7.7 7.2 4.2 7.2-4.2M12 12v8.6M8.2 5.3l7.4 4.4"/>
                  </svg>
                  <strong>{{ section.settings.trust_boxes_count | escape }}</strong>
                  {{ section.settings.trust_boxes_label | escape }}
                </span>
              {%- endif -%}

              {%- if section.settings.trust_link != blank and section.settings.trust_link_text != blank -%}
                <span class="pet-hero-trust__link-label">
                  {{ section.settings.trust_link_text | escape }}
                  <span aria-hidden="true">→</span>
                </span>
              {%- endif -%}
          {%- if section.settings.trust_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="pet-button-row">
        {%- if section.settings.button_dog_label != blank -%}<a class="pet-button pet-hero__sticker-button pet-hero__sticker-button--dog" href="{{ section.settings.button_dog_link | default: routes.all_products_collection_url }}"><span class="pet-hero__sticker-icon" aria-hidden="true">🐶</span><span>{{ section.settings.button_dog_label | escape }}</span></a>{%- endif -%}
        {%- if section.settings.button_cat_label != blank -%}<a class="pet-button pet-hero__sticker-button pet-hero__sticker-button--cat" href="{{ section.settings.button_cat_link | default: routes.all_products_collection_url }}"><span class="pet-hero__sticker-icon" aria-hidden="true">🐱</span><span>{{ section.settings.button_cat_label | escape }}</span></a>{%- endif -%}
      </div>
    </div>
  </div>

  {%- unless use_brand_scene -%}
    <div class="pet-hero__animal pet-hero__animal--cat">
      {%- if section.settings.cat_image != blank -%}
        {% render 'responsive-image', image: section.settings.cat_image, alt: section.settings.cat_alt, class: 'pet-hero__animal-image', sizes: '(max-width: 749px) 52vw, 38vw', priority: true %}
      {%- else -%}
        <div class="pet-hero__animal-placeholder pet-hero__animal-placeholder--cat" role="img" aria-label="{{ section.settings.cat_alt | escape }}">{% render 'icon-cat' %}</div>
      {%- endif -%}
    </div>
  {%- endunless -%}
</section>

{{ 'hero-fourpattes-loop.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Hero animaux",
  "tag": "section",
  "class": "pet-hero-section",
  "settings": [
    { "type": "textarea", "id": "title", "label": "Titre", "default": "ILS ONT CHACUN\nLEUR PETITE\nPRÉFÉRENCE..." },
    { "type": "text", "id": "button_dog_label", "label": "Bouton chiens", "default": "Accessoires chien" },
    { "type": "url", "id": "button_dog_link", "label": "Lien chiens" },
    { "type": "text", "id": "button_cat_label", "label": "Bouton chats", "default": "Accessoires chat" },
    { "type": "url", "id": "button_cat_link", "label": "Lien chats" },
    { "type": "header", "content": "Bandeau de confiance" },
    { "type": "checkbox", "id": "trust_enabled", "label": "Afficher le bandeau", "default": true },
    { "type": "text", "id": "trust_heading", "label": "Mention de confiance", "default": "Excellent" },
    { "type": "text", "id": "trust_rating", "label": "Note affichée", "default": "4,8/5" },
    { "type": "text", "id": "trust_reviews_count", "label": "Nombre d’avis", "default": "684" },
    { "type": "text", "id": "trust_reviews_label", "label": "Libellé des avis", "default": "avis clients" },
    { "type": "text", "id": "trust_boxes_count", "label": "Nombre de box", "default": "2 500" },
    { "type": "text", "id": "trust_boxes_label", "label": "Libellé des box", "default": "box expédiées" },
    { "type": "url", "id": "trust_link", "label": "Lien vers la page Avis" },
    { "type": "text", "id": "trust_link_text", "label": "Texte du lien", "default": "Voir les avis" },
    { "type": "text", "id": "trust_stars_aria_label", "label": "Description accessible des étoiles", "default": "Note moyenne de 4,8 sur 5" },
    { "type": "color", "id": "trust_background_color", "label": "Fond du bandeau", "default": "#FFF9F4" },
    { "type": "color", "id": "trust_text_color", "label": "Texte du bandeau", "default": "#2D1C63" },
    { "type": "color", "id": "trust_star_color", "label": "Carrés des étoiles", "default": "#2F9F75" },
    { "type": "color", "id": "trust_accent_color", "label": "Accent du bandeau", "default": "#F7C84B" },
    { "type": "range", "id": "trust_font_size", "min": 11, "max": 16, "step": 1, "unit": "px", "label": "Taille du bandeau", "default": 13 },
    { "type": "header", "content": "Bannière Fourpattes" },
    { "type": "image_picker", "id": "hero_desktop_image", "label": "Bannière desktop personnalisée" },
    { "type": "image_picker", "id": "hero_mobile_image", "label": "Bannière mobile personnalisée" },
    { "type": "text", "id": "hero_image_alt", "label": "Texte alternatif de la bannière", "default": "Golden retriever et chat gris entourés d’accessoires colorés pour chiens et chats" },
    { "type": "header", "content": "Conversation animée" },
    { "type": "checkbox", "id": "enable_animated_dialogue", "label": "Activer la conversation", "default": true },
    { "type": "text", "id": "dog_dialogue", "label": "Dialogue du chien", "default": "JE PRENDS LA LAISSE !" },
    { "type": "text", "id": "dog_reaction", "label": "Réaction du chien", "default": "🐾 Prêt en 2 secondes" },
    { "type": "text", "id": "cat_dialogue", "label": "Dialogue du chat", "default": "MOI, JE PRENDS LE COUSSIN." },
    { "type": "text", "id": "cat_reaction", "label": "Réaction du chat", "default": "♡ Priorité au confort" },
    { "type": "color", "id": "dialogue_bubble_background", "label": "Fond des bulles", "default": "#FFF9F4" },
    { "type": "color", "id": "dialogue_bubble_border", "label": "Contour des bulles", "default": "#2D1C63" },
    { "type": "color", "id": "dialogue_bubble_text", "label": "Texte des bulles", "default": "#2D1C63" },
    { "type": "range", "id": "dog_dialogue_x", "min": 0, "max": 25, "step": 1, "unit": "%", "label": "Position horizontale — chien", "default": 4 },
    { "type": "range", "id": "dog_dialogue_y", "min": 0, "max": 35, "step": 1, "unit": "%", "label": "Position verticale — chien", "default": 4 },
    { "type": "range", "id": "cat_dialogue_x", "min": 0, "max": 25, "step": 1, "unit": "%", "label": "Position horizontale — chat", "default": 4 },
    { "type": "range", "id": "cat_dialogue_y", "min": 0, "max": 35, "step": 1, "unit": "%", "label": "Position verticale — chat", "default": 4 },
    { "type": "image_picker", "id": "dog_image", "label": "Image du chien détourée" },
    { "type": "text", "id": "dog_alt", "label": "Texte alternatif du chien", "default": "Chien heureux" },
    { "type": "range", "id": "dog_width", "min": 25, "max": 65, "step": 1, "unit": "%", "label": "Taille du chien", "default": 54 },
    { "type": "range", "id": "dog_x", "min": -20, "max": 20, "step": 1, "unit": "%", "label": "Position horizontale du chien", "default": -5 },
    { "type": "range", "id": "dog_y", "min": -15, "max": 25, "step": 1, "unit": "%", "label": "Position verticale du chien", "default": 4 },
    { "type": "image_picker", "id": "cat_image", "label": "Image du chat détourée" },
    { "type": "text", "id": "cat_alt", "label": "Texte alternatif du chat", "default": "Chat curieux" },
    { "type": "range", "id": "cat_width", "min": 25, "max": 65, "step": 1, "unit": "%", "label": "Taille du chat", "default": 50 },
    { "type": "range", "id": "cat_x", "min": -20, "max": 20, "step": 1, "unit": "%", "label": "Position horizontale du chat", "default": -4 },
    { "type": "range", "id": "cat_y", "min": -15, "max": 25, "step": 1, "unit": "%", "label": "Position verticale du chat", "default": 5 },
    { "type": "color", "id": "background", "label": "Fond", "default": "#B7E3FB" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#2D1C63" },
    { "type": "range", "id": "height_mobile", "min": 380, "max": 760, "step": 20, "unit": "px", "label": "Hauteur mobile", "default": 560 },
    { "type": "range", "id": "height_desktop", "min": 500, "max": 900, "step": 20, "unit": "px", "label": "Hauteur ordinateur", "default": 620 },
    { "type": "checkbox", "id": "decorations", "label": "Afficher les décorations", "default": true }
  ],
  "presets": [{ "name": "Hero animaux" }]
}
{% endschema %}
