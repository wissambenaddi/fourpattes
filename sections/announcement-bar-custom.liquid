{%- if section.settings.text != blank -%}
  <aside
    class="pet-announcement{% if section.settings.sticky %} pet-announcement--sticky{% endif %}"
    style="--announcement-bg: {{ section.settings.background }}; --announcement-color: {{ section.settings.text_color }};"
    role="region"
    aria-label="{{ section.settings.accessibility_label | escape }}"
  >
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
      <span>{{ section.settings.text | escape }}</span>
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Barre d’annonce",
  "class": "pet-announcement-section",
  "settings": [
    { "type": "text", "id": "text", "label": "Message", "default": "Livraison offerte dès 49 €" },
    { "type": "url", "id": "link", "label": "Lien" },
    { "type": "text", "id": "accessibility_label", "label": "Libellé d’accessibilité", "default": "Annonce" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#F7C84B" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#332266" },
    { "type": "checkbox", "id": "sticky", "label": "Garder la barre visible", "default": false }
  ],
  "presets": [{ "name": "Barre d’annonce" }]
}
{% endschema %}
