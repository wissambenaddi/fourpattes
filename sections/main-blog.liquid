<section class="pet-blog pet-shell">
  <header class="pet-page-heading"><h1>{{ blog.title }}</h1></header>
  {%- paginate blog.articles by section.settings.articles_per_page -%}
    <div class="pet-content-grid">
      {%- for article in blog.articles -%}
        <article class="pet-content-card">
          {%- if article.image -%}<a href="{{ article.url }}">{{ article.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: article.image.alt | default: article.title }}</a>{%- endif -%}
          <p class="pet-eyebrow">{{ article.published_at | date: '%d/%m/%Y' }}</p>
          <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p>{{ article.excerpt_or_content | strip_html | truncate: 180 }}</p>
        </article>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pet-pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}{ "name": "Blog principal", "settings": [{ "type": "range", "id": "articles_per_page", "min": 3, "max": 18, "step": 3, "label": "Articles par page", "default": 9 }] }{% endschema %}
