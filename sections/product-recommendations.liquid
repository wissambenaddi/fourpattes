<section
  class="pet-recommendations pet-shell"
  data-pet-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.product_count }}"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <h2>{{ section.settings.title | escape }}</h2>
    <div class="pet-product-grid">
      {%- for product in recommendations.products -%}{% render 'product-card-pet', product: product, index: forloop.index, show_quick_add: true %}{%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Recommandations produits",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "VOUS AIMEREZ AUSSI" },
    { "type": "range", "id": "product_count", "min": 2, "max": 8, "step": 1, "label": "Nombre de produits", "default": 4 }
  ]
}
{% endschema %}
