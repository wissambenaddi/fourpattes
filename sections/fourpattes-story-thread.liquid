{%- liquid
  assign thread_opacity = section.settings.opacity | divided_by: 100.0
  assign reveal_class = ' is-visible'
  if section.settings.enable_animations
    assign reveal_class = ' pet-story-thread--motion'
  endif
-%}

<style>
  #shopify-section-{{ section.id }}{position:relative;z-index:2;height:0;min-height:0;overflow:visible}
</style>

{%- if section.settings.enabled -%}
  <div
    class="pet-story-thread pet-story-thread--{{ section.settings.alignment }}{% unless section.settings.show_on_mobile %} pet-story-thread--hide-mobile{% endunless %}{{ reveal_class }}"
    style="--thread-color: {{ section.settings.line_color }}; --thread-opacity: {{ thread_opacity }}; --story-object-color: {{ section.settings.object_color }}; --story-object-secondary: {{ section.settings.secondary_color }};"
    aria-hidden="true"
    {% if section.settings.enable_animations %}data-pet-reveal{% endif %}
  >
    <div class="pet-story-thread__stage">
      <svg class="pet-story-thread__path" viewBox="0 0 220 120" preserveAspectRatio="none" focusable="false">
        <path pathLength="1" d="M18 18C62 8 78 58 116 52S166 76 204 99"/>
      </svg>
      <span class="pet-story-thread__item">
        {% render 'fourpattes-story-object', object_type: section.settings.object_type, color: section.settings.object_color, secondary_color: section.settings.secondary_color %}
      </span>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Liaison Box → accessoires",
  "tag": "section",
  "class": "fourpattes-story-thread",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Afficher la liaison",
      "default": true
    },
    {
      "type": "select",
      "id": "object_type",
      "label": "Objet narratif",
      "options": [
        { "value": "ball", "label": "Balle" },
        { "value": "leash", "label": "Laisse" },
        { "value": "mouse", "label": "Souris" },
        { "value": "yarn", "label": "Pelote" }
      ],
      "default": "ball"
    },
    {
      "type": "color",
      "id": "object_color",
      "label": "Couleur de l’objet",
      "default": "#F4B63F"
    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Couleur secondaire",
      "default": "#2D1C63"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Couleur de la trajectoire",
      "default": "#BFE2F3"
    },
    {
      "type": "range",
      "id": "opacity",
      "min": 45,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Opacité de la trajectoire",
      "default": 50
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Position",
      "options": [
        { "value": "left", "label": "À gauche" },
        { "value": "right", "label": "À droite" }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "enable_animations",
      "label": "Animer l’apparition",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Afficher sur mobile",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Liaison Box → accessoires"
    }
  ]
}
{% endschema %}
