<section
  class="pet-playful"
  style="--playful-bg: {{ section.settings.background }}; --playful-title: {{ section.settings.title_color }}; --playful-card: {{ section.settings.card_color }}; --playful-mascot: {{ section.settings.mascot_color }};"
  data-pet-reveal
>
  <div class="pet-shell pet-playful__inner">
    <div class="pet-playful__decor" aria-hidden="true">
      <span class="pet-playful__decor-star">✦</span>
      <span class="pet-playful__decor-bubble">HEY !</span>
      <span class="pet-playful__decor-lines">)))</span>
      <span class="pet-playful__decor-paw">{% render 'icon-paw' %}</span>
    </div>
    <div class="pet-playful__content">
      <h2>{{ section.settings.title | escape | newline_to_br }}</h2>
      <div class="pet-playful__card">
        <h3>{{ section.settings.card_title | escape }}</h3>
        <div>{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}<a class="pet-button pet-button--light" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
        <span class="pet-playful__scroll" aria-hidden="true"><i></i></span>
      </div>
    </div>

    <div class="pet-playful__mascot">
      {%- if section.settings.mascot != blank -%}
        {% render 'responsive-image', image: section.settings.mascot, alt: section.settings.mascot_alt, class: 'pet-playful__mascot-image', sizes: '(max-width: 749px) 66vw, 520px' %}
      {%- else -%}
        <img
          class="pet-playful__mascot-image pet-playful__mascot-image--fallback"
          src="{{ 'mascotte-fourpattes-bandana.webp' | asset_url }}"
          width="863"
          height="1027"
          loading="lazy"
          alt="Chat mascotte orange avec bandana violet, médaille turquoise et balle jaune"
        >
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Appel ludique",
  "settings": [
    { "type": "textarea", "id": "title", "label": "Titre", "default": "WOW, MÊME NOTRE MASCOTTE\nN’A JAMAIS SCROLLÉ JUSQUE-LÀ…" },
    { "type": "text", "id": "card_title", "label": "Titre de la carte", "default": "CLAIREMENT, VOUS AVEZ DU FLAIR" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Découvrez notre sélection pensée avec attention pour les chiens, les chats et les humains qui les aiment.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir la boutique" },
    { "type": "url", "id": "button_link", "label": "Lien" },
    { "type": "image_picker", "id": "mascot", "label": "Mascotte originale" },
    { "type": "text", "id": "mascot_alt", "label": "Texte alternatif", "default": "Mascotte Fourpattes" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#F9F0EB" },
    { "type": "color", "id": "title_color", "label": "Titre", "default": "#C82552" },
    { "type": "color", "id": "card_color", "label": "Carte", "default": "#C82552" },
    { "type": "color", "id": "mascot_color", "label": "Mascotte par défaut", "default": "#FFBE58" }
  ],
  "presets": [{ "name": "Appel ludique" }]
}
{% endschema %}
