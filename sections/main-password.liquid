<main class="pet-password pet-shell">
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<div class="pet-rte">{{ shop.password_message }}</div>{%- endif -%}
  {%- form 'storefront_password', class: 'pet-password__form' -%}
    {%- if form.errors -%}<div class="pet-form-message pet-form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label for="Password">Mot de passe</label>
    <input id="Password" type="password" name="password" required>
    <button class="pet-button" type="submit">Entrer</button>
  {%- endform -%}
</main>
{% schema %}{ "name": "Page protégée", "settings": [] }{% endschema %}
