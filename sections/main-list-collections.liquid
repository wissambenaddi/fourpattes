<section class="pet-list-collections pet-shell">
  <header class="pet-page-heading"><h1>{{ section.settings.title | escape }}</h1></header>
  <div class="pet-content-grid">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <article class="pet-content-card">
          <a href="{{ collection.url }}">{%- if collection.featured_image -%}{{ collection.featured_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: collection.featured_image.alt | default: collection.title }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}<h2>{{ collection.title }}</h2></a>
        </article>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}{ "name": "Liste des collections", "settings": [{ "type": "text", "id": "title", "label": "Titre", "default": "NOS COLLECTIONS" }] }{% endschema %}
