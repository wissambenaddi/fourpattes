<section
  class="pet-bowl pet-bowl--{{ section.settings.variant }}{% if section.settings.variant == 'teal' %} pet-bowl--gift-box{% else %} pet-bowl--life{% if section.settings.enable_scene_animations %} pet-bowl--life-animated{% endif %}{% endif %}"
  style="
    --bowl-bg: {{ section.settings.background }};
    --bowl-color: {{ section.settings.text_color }};
    --bowl-accent: {{ section.settings.accent_color }};
    --bowl-min-mobile: {{ section.settings.height_mobile }}px;
    --bowl-min-desktop: {{ section.settings.height_desktop }}px;
    --bowl-size: {{ section.settings.image_size }}%;
    --bowl-x: {{ section.settings.image_x }}%;
    --bowl-y: {{ section.settings.image_y }}%;
  "
  data-pet-reveal
>
  {% render 'wave-divider', color: section.settings.background, position: 'top', flip: section.settings.flip_top_wave %}
  {%- if section.settings.variant == 'lime' and section.settings.decorations -%}
    <div class="pet-life-transition" aria-hidden="true">
      <span class="pet-life-transition__paw pet-life-transition__paw--one">{% render 'icon-paw' %}</span>
      <span class="pet-life-transition__paw pet-life-transition__paw--two">{% render 'icon-paw' %}</span>
      <span class="pet-life-transition__paw pet-life-transition__paw--three">{% render 'icon-paw' %}</span>
      <span class="pet-life-transition__ball"></span>
      <span class="pet-life-transition__mouse"></span>
      <span class="pet-life-transition__spark">✦</span>
    </div>
  {%- endif -%}
  <div class="pet-shell pet-bowl__inner">
    <header class="pet-bowl__heading">
      <h2>{{ section.settings.title | escape | newline_to_br }}</h2>
      {%- if section.settings.subtitle != blank -%}<p>{{ section.settings.subtitle | escape }}</p>{%- endif -%}
    </header>

    {%- if section.settings.variant == 'teal' -%}
      <div class="pet-gift-story">
        {%- if section.settings.decorations -%}
          <div class="pet-gift-story__decor" aria-hidden="true">
            <span class="pet-gift-story__spark pet-gift-story__spark--one">✦</span>
            <span class="pet-gift-story__spark pet-gift-story__spark--two">✧</span>
            <span class="pet-gift-story__spark pet-gift-story__spark--three">♡</span>
            <span class="pet-gift-story__paw">{% render 'icon-paw' %}</span>
          </div>
        {%- endif -%}

        <div class="pet-gift-story__cards pet-gift-story__cards--left">
          <article class="pet-gift-card pet-gift-card--one">
            <span class="pet-gift-card__icon" aria-hidden="true">{% render 'pet-icon', name: 'payment' %}</span>
            <div><h3>{{ section.settings.quality_title | escape }}</h3><p>{{ section.settings.quality_text | escape }}</p></div>
          </article>
          <article class="pet-gift-card pet-gift-card--two">
            <span class="pet-gift-card__icon" aria-hidden="true">{% render 'icon-paw' %}</span>
            <div><h3>{{ section.settings.comfort_title | escape }}</h3><p>{{ section.settings.comfort_text | escape }}</p></div>
          </article>
        </div>

        <figure class="pet-gift-box" role="img" aria-label="{{ section.settings.gift_box_alt | escape }}">
          <span class="pet-gift-box__halo" aria-hidden="true"></span>
          <span class="pet-gift-box__light" aria-hidden="true"></span>
          <div class="pet-gift-box__interior" aria-hidden="true">
            <span class="pet-gift-box__tape-top"></span>
          </div>
          <div class="pet-gift-box__accessories" aria-hidden="true">
            <span class="pet-gift-box__tissue pet-gift-box__tissue--left"></span>
            <span class="pet-gift-box__tissue pet-gift-box__tissue--center"></span>
            <span class="pet-gift-box__tissue pet-gift-box__tissue--right"></span>
            {%- if section.settings.gift_accessories_image != blank -%}
              {{ section.settings.gift_accessories_image | image_url: width: 900 | image_tag: class: 'pet-gift-box__accessories-image', widths: '320, 480, 700, 900', sizes: '(max-width: 749px) 76vw, 500px', loading: 'lazy', alt: '' }}
            {%- else -%}
              <img class="pet-gift-box__accessories-image" src="{{ 'kit-promenade-fourpattes.webp' | asset_url }}" width="1286" height="876" loading="lazy" alt="">
            {%- endif -%}
            <span class="pet-gift-box__ball"></span>
            <span class="pet-gift-box__mouse"></span>
          </div>
          <div class="pet-gift-box__lid pet-gift-box__lid--back" aria-hidden="true"></div>
          <div class="pet-gift-box__flap pet-gift-box__flap--left" aria-hidden="true"></div>
          <div class="pet-gift-box__flap pet-gift-box__flap--right" aria-hidden="true"></div>
          <div class="pet-gift-box__flap pet-gift-box__flap--front" aria-hidden="true"></div>
          <span class="pet-gift-box__side pet-gift-box__side--left" aria-hidden="true"></span>
          <span class="pet-gift-box__side pet-gift-box__side--right" aria-hidden="true"></span>
          <div class="pet-gift-box__body" aria-hidden="true">
            <span class="pet-gift-box__kraft-texture"></span>
            <span class="pet-gift-box__print pet-gift-box__print--paw">{% render 'icon-paw' %}</span>
            <span class="pet-gift-box__print pet-gift-box__print--star">✦</span>
            <span class="pet-gift-box__print pet-gift-box__print--heart">♡</span>
            <span class="pet-gift-box__print pet-gift-box__print--bone"></span>
            <span class="pet-gift-box__tape"></span>
            <span class="pet-gift-box__tape-lifted"></span>
            <img class="pet-gift-box__logo" src="{{ 'fourpattes-logo.webp' | asset_url }}" width="720" height="195" loading="lazy" alt="">
          </div>
          <span class="pet-gift-box__string" aria-hidden="true"></span>
          <span class="pet-gift-box__tag" aria-hidden="true">Préparé avec soin</span>
        </figure>

        <div class="pet-gift-story__cards pet-gift-story__cards--right">
          <article class="pet-gift-card pet-gift-card--three">
            <span class="pet-gift-card__icon pet-gift-card__icon--spark" aria-hidden="true">✦</span>
            <div><h3>{{ section.settings.style_title | escape }}</h3><p>{{ section.settings.style_text | escape }}</p></div>
          </article>
          <article class="pet-gift-card pet-gift-card--four">
            <span class="pet-gift-card__icon" aria-hidden="true">{% render 'pet-icon', name: 'shipping' %}</span>
            <div><h3>{{ section.settings.originality_title | escape }}</h3><p>{{ section.settings.originality_text | escape }}</p></div>
          </article>
          <article class="pet-gift-card pet-gift-card--five">
            <span class="pet-gift-card__icon" aria-hidden="true">{% render 'pet-icon', name: 'support' %}</span>
            <div><h3>{{ section.settings.durability_title | escape }}</h3><p>{{ section.settings.durability_text | escape }}</p></div>
          </article>
        </div>
      </div>
    {%- else -%}
      <div class="pet-life">
        {%- if section.settings.decorations -%}
          <div class="pet-life__ambient" aria-hidden="true">
            <span class="pet-life__doodle pet-life__doodle--paw-one">{% render 'icon-paw' %}</span>
            <span class="pet-life__doodle pet-life__doodle--paw-two">{% render 'icon-paw' %}</span>
            <span class="pet-life__doodle pet-life__doodle--heart">♡</span>
            <span class="pet-life__doodle pet-life__doodle--star-one">✦</span>
            <span class="pet-life__doodle pet-life__doodle--star-two">✧</span>
            <span class="pet-life__doodle pet-life__doodle--dots">· · ·</span>
            <span class="pet-life__doodle pet-life__doodle--leaf">❧</span>
          </div>
          <svg class="pet-life__connectors" viewBox="0 0 1200 700" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path class="pet-life__connector pet-life__connector--one" pathLength="1" d="M487 250C405 193 332 145 224 131"/>
            <path class="pet-life__connector pet-life__connector--two" pathLength="1" d="M714 247C808 180 903 154 1015 157"/>
            <path class="pet-life__connector pet-life__connector--three" pathLength="1" d="M444 373C334 359 255 377 176 425"/>
            <path class="pet-life__connector pet-life__connector--four" pathLength="1" d="M760 371C857 368 943 400 1024 456"/>
            <path class="pet-life__connector pet-life__connector--five" pathLength="1" d="M535 500C465 558 405 591 322 611"/>
          </svg>
        {%- endif -%}

        <figure
          class="pet-life__companions"
          style="--companions-size: {{ section.settings.image_size }}%; --companions-x: {{ section.settings.image_x }}%; --companions-y: {{ section.settings.image_y }}%;"
        >
          <span class="pet-life__companions-halo" aria-hidden="true"></span>
          {%- if section.settings.image != blank -%}
            {% render 'responsive-image', image: section.settings.image, alt: section.settings.image_alt, class: 'pet-life__companions-image', sizes: '(max-width: 749px) 88vw, (max-width: 989px) 58vw, 560px' %}
          {%- else -%}
            <div class="pet-life__companions-fallback" role="img" aria-label="{{ section.settings.image_alt | escape }}">
              {% render 'pet-life-companions' %}
            </div>
          {%- endif -%}
          {%- if section.settings.annotation != blank -%}
            <figcaption>{{ section.settings.annotation | escape | newline_to_br }}</figcaption>
          {%- endif -%}
        </figure>

        <div class="pet-life__items">
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_text = block.settings.text
              if card_text == blank and block.settings.kind == 'ball'
                assign card_text = section.settings.fact_one
              elsif card_text == blank and block.settings.kind == 'leash'
                assign card_text = section.settings.fact_two
              elsif card_text == blank and block.settings.kind == 'cushion'
                assign card_text = section.settings.fact_three
              endif
            -%}
            <article
              class="pet-life__item pet-life__item--{{ block.settings.slot }} pet-life__item--motion-{{ block.settings.motion }}"
              style="--item-color: {{ block.settings.color }}; --item-rotation: {{ block.settings.rotation }}deg;"
              {{ block.shopify_attributes }}
            >
              <div class="pet-life__visual">
                {%- if block.settings.image != blank -%}
                  {% render 'responsive-image', image: block.settings.image, alt: block.settings.image_alt, class: 'pet-life__visual-image', sizes: '(max-width: 359px) 52vw, (max-width: 749px) 34vw, (max-width: 989px) 20vw, 170px' %}
                {%- else -%}
                  <div class="pet-life__fallback" role="img" aria-label="{{ block.settings.image_alt | escape }}">
                    {%- case block.settings.kind -%}
                      {%- when 'ball' -%}
                        <svg viewBox="0 0 240 210" aria-hidden="true" focusable="false">
                          <ellipse class="pet-life__shadow" cx="120" cy="184" rx="72" ry="13"/>
                          <circle class="pet-life__shape" cx="120" cy="104" r="72"/>
                          <path class="pet-life__detail pet-life__detail--wide" d="M48 101c41-18 102-16 144 3M83 42c15 39 16 84 0 123M157 43c-16 39-16 83 0 122"/>
                        </svg>
                      {%- when 'leash' -%}
                        <svg viewBox="0 0 300 220" aria-hidden="true" focusable="false">
                          <ellipse class="pet-life__shadow" cx="149" cy="190" rx="108" ry="12"/>
                          <path class="pet-life__detail pet-life__detail--leash" d="M70 156c-54-16-42-91 13-105 45-11 78 29 51 58-23 24-72 9-60-20 10-25 54-18 88 10 34 29 52 61 78 68"/>
                          <path class="pet-life__shape-stroke" d="M62 153c-14 10-19 24-7 31 14 7 28-5 34-19"/>
                          <path class="pet-life__metal" d="m230 157 28 17-10 17-28-18zM253 176l19 5-7 12-17-4"/>
                        </svg>
                      {%- when 'cushion' -%}
                        <svg viewBox="0 0 300 220" aria-hidden="true" focusable="false">
                          <ellipse class="pet-life__shadow" cx="151" cy="187" rx="112" ry="15"/>
                          <path class="pet-life__shape" d="M56 69c8-23 28-33 54-28 27 5 52 5 79 0 28-5 50 8 57 32 9 30 5 72-10 94-15 21-42 25-67 18-15-4-27-4-43 0-29 7-57-2-69-27-12-25-11-62-1-89Z"/>
                          <path class="pet-life__detail" d="M79 77c39 13 101 14 144 0M79 153c41-13 103-13 144 0"/>
                          <path class="pet-life__detail pet-life__detail--bone" d="M123 109c-10-15-25-3-16 8-9 13 7 24 17 9h49c10 15 26 4 17-9 9-12-6-23-17-8z"/>
                        </svg>
                      {%- when 'mouse' -%}
                        <svg viewBox="0 0 280 210" aria-hidden="true" focusable="false">
                          <ellipse class="pet-life__shadow" cx="133" cy="178" rx="96" ry="12"/>
                          <path class="pet-life__tail" d="M199 143c42-4 61-25 42-42-13-12-27-2-19 9"/>
                          <ellipse class="pet-life__shape" cx="130" cy="119" rx="78" ry="51" transform="rotate(-8 130 119)"/>
                          <circle class="pet-life__ear" cx="86" cy="76" r="23"/>
                          <circle class="pet-life__ear-inner" cx="86" cy="76" r="12"/>
                          <circle class="pet-life__eye" cx="166" cy="105" r="5"/>
                          <circle class="pet-life__nose" cx="207" cy="123" r="7"/>
                          <path class="pet-life__whisker" d="M190 116l33-13M191 126l38 1M188 135l32 14"/>
                        </svg>
                      {%- when 'harness' -%}
                        <svg viewBox="0 0 280 230" aria-hidden="true" focusable="false">
                          <ellipse class="pet-life__shadow" cx="141" cy="201" rx="92" ry="13"/>
                          <path class="pet-life__shape-stroke pet-life__shape-stroke--harness" d="M79 57c18 31 23 65 21 104m101-104c-18 31-23 65-21 104M80 58c37 18 83 18 120 0M100 159c26 18 54 18 80 0"/>
                          <path class="pet-life__shape" d="M111 75h59l15 70-44 31-44-31z"/>
                          <path class="pet-life__detail" d="M141 81v86M107 126h68"/>
                          <rect class="pet-life__metal" x="131" y="38" width="20" height="32" rx="8"/>
                        </svg>
                    {%- endcase -%}
                  </div>
                {%- endif -%}
              </div>

              <div class="pet-life__card">
                {%- if block.settings.badge != blank -%}<span class="pet-life__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
                <span class="pet-life__card-icon" aria-hidden="true">{% render 'icon-paw' %}</span>
                <div>
                  {%- if block.settings.label != blank -%}<p>{{ block.settings.label | escape }}</p>{%- endif -%}
                  {%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
                  {%- if card_text != blank -%}<small>{{ card_text | escape }}</small>{%- endif -%}
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>

    {%- endif -%}
  </div>

  {%- if section.settings.show_bottom_wave -%}
    {% render 'wave-divider', color: section.settings.bottom_color, position: 'bottom', flip: section.settings.flip_bottom_wave %}
  {%- endif -%}
</section>

{{ 'gift-box-story.css' | asset_url | stylesheet_tag }}
{%- if section.settings.variant == 'lime' -%}
  {{ 'accessory-life-story.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{% schema %}
{
  "name": "Mise en avant gamelle",
  "settings": [
    { "type": "select", "id": "variant", "label": "Variante", "options": [{ "value": "teal", "label": "Bleu-vert" }, { "value": "lime", "label": "Verte" }], "default": "teal" },
    { "type": "textarea", "id": "title", "label": "Titre", "default": "CE QUI RENTRE AVEC\nFOURPATTES" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "DU BON, DU BEAU, DU JOYEUX" },
    { "type": "header", "content": "Colis cadeau — variante bleu-vert" },
    { "type": "image_picker", "id": "gift_accessories_image", "label": "Accessoires dépassant du colis" },
    { "type": "text", "id": "gift_box_alt", "label": "Texte alternatif du colis", "default": "Boîte cadeau Fourpattes ouverte remplie d’accessoires pour chiens et chats" },
    { "type": "text", "id": "quality_title", "label": "Carte 1 — titre", "default": "QUALITÉ" },
    { "type": "text", "id": "quality_text", "label": "Carte 1 — texte", "default": "Des matériaux sélectionnés avec soin." },
    { "type": "text", "id": "comfort_title", "label": "Carte 2 — titre", "default": "CONFORT" },
    { "type": "text", "id": "comfort_text", "label": "Carte 2 — texte", "default": "Pensé pour leur bien-être." },
    { "type": "text", "id": "style_title", "label": "Carte 3 — titre", "default": "STYLE" },
    { "type": "text", "id": "style_text", "label": "Carte 3 — texte", "default": "Des accessoires pleins de personnalité." },
    { "type": "text", "id": "originality_title", "label": "Carte 4 — titre", "default": "ORIGINALITÉ" },
    { "type": "text", "id": "originality_text", "label": "Carte 4 — texte", "default": "Des créations qui sortent de l’ordinaire." },
    { "type": "text", "id": "durability_title", "label": "Carte 5 — titre", "default": "DURABILITÉ" },
    { "type": "text", "id": "durability_text", "label": "Carte 5 — texte", "default": "Des produits faits pour durer." },
    { "type": "image_picker", "id": "image", "label": "Image de la gamelle" },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif", "default": "Gamelle Fourpattes" },
    { "type": "textarea", "id": "annotation", "label": "Annotation", "default": "Une gamelle pensée\npour les petits bonheurs" },
    { "type": "text", "id": "fact_one", "label": "Point fort 1", "default": "Pensé pour leur bien-être" },
    { "type": "text", "id": "fact_two", "label": "Point fort 2", "default": "Des moments de complicité" },
    { "type": "text", "id": "fact_three", "label": "Point fort 3", "default": "Sélectionné avec attention" },
    { "type": "range", "id": "image_size", "min": 35, "max": 85, "step": 1, "unit": "%", "label": "Taille de l’image", "default": 72 },
    { "type": "range", "id": "image_x", "min": -25, "max": 25, "step": 1, "unit": "%", "label": "Décalage horizontal", "default": -6 },
    { "type": "range", "id": "image_y", "min": -10, "max": 35, "step": 1, "unit": "%", "label": "Décalage vertical", "default": 6 },
    { "type": "range", "id": "height_mobile", "min": 620, "max": 1300, "step": 20, "unit": "px", "label": "Hauteur mobile", "default": 780 },
    { "type": "range", "id": "height_desktop", "min": 580, "max": 1000, "step": 20, "unit": "px", "label": "Hauteur ordinateur", "default": 660 },
    { "type": "color", "id": "background", "label": "Fond", "default": "#005E66" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#F7C84B" },
    { "type": "color", "id": "accent_color", "label": "Décorations", "default": "#65B2B2" },
    { "type": "checkbox", "id": "decorations", "label": "Afficher les décorations", "default": true },
    { "type": "checkbox", "id": "enable_scene_animations", "label": "Animer discrètement la scène verte", "default": true },
    { "type": "checkbox", "id": "flip_top_wave", "label": "Inverser la vague supérieure", "default": false },
    { "type": "checkbox", "id": "show_bottom_wave", "label": "Afficher la vague inférieure", "default": false },
    { "type": "color", "id": "bottom_color", "label": "Couleur sous la vague", "default": "#F9F0EB" },
    { "type": "checkbox", "id": "flip_bottom_wave", "label": "Inverser la vague inférieure", "default": true }
  ],
  "blocks": [
    {
      "type": "accessory",
      "name": "Accessoire — scène de vie",
      "limit": 5,
      "settings": [
        { "type": "select", "id": "kind", "label": "Type d’accessoire", "options": [{ "value": "ball", "label": "Balle" }, { "value": "leash", "label": "Laisse" }, { "value": "cushion", "label": "Coussin" }, { "value": "mouse", "label": "Souris" }, { "value": "harness", "label": "Harnais" }], "default": "ball" },
        { "type": "image_picker", "id": "image", "label": "Image de l’accessoire" },
        { "type": "text", "id": "image_alt", "label": "Texte alternatif", "default": "Accessoire Fourpattes prêt à être utilisé" },
        { "type": "text", "id": "label", "label": "Catégorie", "default": "JEU" },
        { "type": "text", "id": "title", "label": "Nom", "default": "Balle" },
        { "type": "text", "id": "text", "label": "Courte phrase" },
        { "type": "text", "id": "badge", "label": "Badge facultatif" },
        { "type": "select", "id": "slot", "label": "Position dans la scène", "options": [{ "value": "one", "label": "Position 1" }, { "value": "two", "label": "Position 2" }, { "value": "three", "label": "Position 3" }, { "value": "four", "label": "Position 4" }, { "value": "five", "label": "Position 5" }], "default": "one" },
        { "type": "select", "id": "motion", "label": "Micro-animation", "options": [{ "value": "none", "label": "Aucune" }, { "value": "roll", "label": "Très léger roulement" }, { "value": "breathe", "label": "Respiration discrète" }, { "value": "float", "label": "Flottement discret" }], "default": "none" },
        { "type": "range", "id": "rotation", "min": -8, "max": 8, "step": 1, "unit": "deg", "label": "Inclinaison", "default": 0 },
        { "type": "color", "id": "color", "label": "Couleur de l’illustration", "default": "#27C6CC" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    { "name": "Gamelle bleu-vert" },
    {
      "name": "Vie des accessoires",
      "settings": { "variant": "lime", "title": "TOUT CE QUI PART AVEC\nFOURPATTES", "subtitle": "Des essentiels joyeux, pensés pour leur bien-être au quotidien.", "image_alt": "Chien et chat Fourpattes assis ensemble au centre de leurs accessoires", "annotation": "Une attention pour chaque moment partagé.", "image_size": 56, "image_x": 0, "image_y": 0, "background": "#B1CD71", "text_color": "#005E66", "accent_color": "#82B45F", "enable_scene_animations": true },
      "blocks": [
