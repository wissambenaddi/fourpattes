<section class="pet-search pet-shell">
  <header class="pet-page-heading"><h1>{{ 'general.search' | t }}</h1></header>
  <form class="pet-search__form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="pet-visually-hidden" for="SearchInput-{{ section.id }}">{{ 'general.search' | t }}</label>
    <input id="SearchInput-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}">
    <button class="pet-button" type="submit">{{ 'general.search' | t }}</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 20 -%}
      <p>{{ search.results_count }} résultat(s)</p>
      <div class="pet-search__results">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card-pet', product: item, index: forloop.index, show_quick_add: true %}{%- else -%}<article class="pet-content-card"><h2><a href="{{ item.url }}">{{ item.title }}</a></h2><p>{{ item.content | strip_html | truncate: 180 }}</p></article>{%- endif -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pet-pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>
{% schema %}{ "name": "Recherche principale", "settings": [] }{% endschema %}
